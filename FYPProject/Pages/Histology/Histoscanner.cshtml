@page
<!DOCTYPE html>
<html>
<head>
    @await Html.PartialAsync("navbar");
    <title>Histoscanner</title>
</head>
<body>
    <h1>Teachable Machine Image Model</h1>
    <img id="imagePreview" style="height: 300px; display: none;" alt="Preview of uploaded image" />
    <input id="imageUpload" type="file" accept="image/*" />
    <div id="label-container"></div>

    <!-- Load TensorFlow.js and Teachable Machine libraries -->
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow/tfjs@1.3.1/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@teachablemachine/image@0.8/dist/teachablemachine-image.min.js"></script>

    <script>
        // Link to the Teachable Machine model
        const URL = 'https://teachablemachine.withgoogle.com/models/sUSmNqeOZ/';
        let model, labelContainer, maxPredictions;

        // Initialize the model
        async function init() {
            const modelURL = URL + 'model.json';
            const metadataURL = URL + 'metadata.json';

            // Load the model and metadata
            model = await tmImage.load(modelURL, metadataURL);
            maxPredictions = model.getTotalClasses();

            // Create label container elements
            labelContainer = document.getElementById('label-container');
            labelContainer.innerHTML = ''; // Clear previous labels
            for (let i = 0; i < maxPredictions; i++) {
                const labelElement = document.createElement('div');
                labelElement.id = `label-${i}`;
                labelContainer.appendChild(labelElement);
            }
        }

        // Predict the uploaded image
        async function predict() {
            const image = document.getElementById('imagePreview');
            // Clear previous predictions
            labelContainer.innerHTML = '';
            const prediction = await model.predict(image, false);

            // Display predictions
            prediction.forEach((p) => {
                if (p.probability > 0.99) { // Check if the probability is exactly 100%
                    const classPrediction = `${p.className}`;
                    const resultElement = document.createElement('div');
                    resultElement.innerText = classPrediction;
                    labelContainer.appendChild(resultElement);
                }
            });
        }

        // Handle file upload and display the image
        function readURL(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const imagePreview = document.getElementById('imagePreview');
                    imagePreview.src = e.target.result;
                    imagePreview.style.display = 'block';

                    // Ensure the image is loaded before prediction
                    imagePreview.onload = function () {
                        predict();
                    };
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Add event listener for the file input
        document.getElementById('imageUpload').addEventListener('change', function () {
            readURL(this);
        });

        // Load the model on page load
        window.onload = init;
    </script>
</body>
</html>
