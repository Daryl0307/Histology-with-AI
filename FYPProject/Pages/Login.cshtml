@page
@model FYPProject.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-image: url('images/f6-smInt-thumbnail.png');
            background-size: cover; /* Ensures the image covers the whole screen */
            background-repeat: no-repeat; /* Prevents the image from repeating */
            background-position: center center; /* Centers the image */
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .login-card {
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.1);
            width: 75%;
            padding: 30px;
            text-align: center;
        }

            .login-card img {
                height: 100px;
            }

            .login-card h1 {
                font-size: 24px;
                font-weight: bold;
                margin-bottom: 20px;
                color: #333;
            }

            .login-card .form-control {
                border: 1px solid #ddd;
                border-radius: 4px;
                padding: 10px;
                width: 100%;
                margin-bottom: 15px;
                font-size: 14px;
            }

                .login-card .form-control:focus {
                    border-color: #007bff;
                    outline: none;
                    box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
                }

            .login-card .btn-primary {
                background-color: #007bff;
                border: none;
                padding: 10px 15px;
                border-radius: 4px;
                color: #fff;
                cursor: pointer;
                font-size: 16px;
                width: 100%;
                margin-top: 10px;
            }

                .login-card .btn-primary:hover {
                    background-color: #0056b3;
                }

            .login-card p {
                margin-top: 20px;
                font-size: 14px;
                color: #666;
                font-weight: bold;
            }

                .login-card p a {
                    color: #007bff;
                    text-decoration: none;
                }

                    .login-card p a:hover {
                        text-decoration: underline;
                    }
    </style>
</head>
<body>
    <div class="login-card" style="margin:50px auto;">
        <img src="images/logo.png" alt="Logo">
        <h1>@ViewData["Title"]</h1>
        <p>Sign in to start your session</p>
        <form method="post">
            @Html.AntiForgeryToken()
            <input name="Username" type="text" id="Username" class="form-control" style="box-sizing: border-box;" placeholder="Enter User ID" required />
            <input name="Password" type="password" id="Password" class="form-control" style="box-sizing: border-box;" placeholder="Enter Password" required />
            <button type="submit" class="btn-primary">Sign In</button>
        </form>
        <p>Don't have an account? <a href="/Signup">Sign up here</a></p>
    </div>
</body>
</html>
