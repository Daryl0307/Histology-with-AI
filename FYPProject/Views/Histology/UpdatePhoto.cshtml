@model FYPProject.Models.HomeContent

@{
    ViewData["Title"] = "Update Content";
}

<style>
    body {
        background-color: #80cbc4 !important;
        font-family: 'Poppins', sans-serif;
        margin: 0;
        padding: 0;
    }

    .container {
        max-width: 600px;
        margin: 50px auto;
        background: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        text-align: center;
    }

    .preview-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 20px;
    }

    .preview-box {
        width: 100%;
        max-width: 280px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow: hidden;
    }

        .preview-box img {
            width: 100%;
            max-height: 200px;
            object-fit: contain;
            border-radius: 5px;
            border: 1px solid #ccc;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

    .desc-box {
        width: 100%;
        padding: 10px;
        border-radius: 5px;
        background: #f5f5f5;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: 16px;
        font-weight: bold;
        min-height: 60px;
        color: #333;
        word-wrap: break-word;
        overflow-wrap: break-word;
        white-space: pre-wrap;
    }

    input, textarea {
        width: 100%;
        padding: 8px;
        margin: 10px 0;
        border-radius: 5px;
        border: 1px solid #ccc;
        font-size: 16px;
        box-sizing: border-box;
    }

    .char-counter {
        font-size: 14px;
        color: #555;
        text-align: right;
        margin-top: 5px;
    }

        .char-counter.warning {
            color: red;
            font-weight: bold;
        }

    .button-group {
        margin-top: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    button {
        padding: 12px 18px;
        background: #1976d2;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s ease;
        width: 100%;
        max-width: 250px;
    }

        button:hover {
            background: #0d47a1;
        }

    .cancel-btn {
        margin-top: 15px;
        padding: 10px;
        border-radius: 5px;
        text-decoration: none;
        border: 1px solid #ccc;
        transition: background 0.3s ease, color 0.3s ease;
        font-size: 16px;
        text-align: center;
        width: 100%;
        max-width: 250px;
    }

        .cancel-btn:hover {
            background: #ccc;
            color: black;
        }

    @@media (max-width: 768px) {
        .container

    {
        max-width: 90%;
        padding: 15px;
    }

    }
</style>

@if (Model != null)
{
    <div class="container">
        <h2>Update Content</h2>

        <form method="post" enctype="multipart/form-data" asp-action="UpdatePhoto" asp-controller="Admin">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="preview-container">
                <div class="preview-box">
                    <h4>Before</h4>
                    <img src="@Model.Url" id="beforeImage" alt="@Model.Description">
                    <div class="desc-box" id="beforeDescription">@Model.Description</div>
                </div>

                <div class="preview-box">
                    <h4>After</h4>
                    <img id="afterImage" class="desc-box" style="display: none;">
                    <div class="desc-box" id="afterDescription">Preview here</div>
                </div>
            </div>

            <label>Change Image:</label>
            <input type="file" name="file" accept="image/*" id="fileInput" />

            <label>Update Description:</label>
            <textarea name="description" id="descInput" maxlength="225" required>@Model.Description</textarea>
            <div id="charCount" class="char-counter">0 / 225</div>

            <div class="button-group">
                <button type="submit">Update Content</button>
                <a href="/Histology/Home" class="cancel-btn">Back to Home</a>
            </div>
        </form>
    </div>

    <script>
        document.getElementById('fileInput').addEventListener('change', function(event) {
            const file = event.target.files[0];
            const afterImage = document.getElementById('afterImage');
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    afterImage.src = e.target.result;
                    afterImage.style.display = "block";
                };
                reader.readAsDataURL(file);
            }
        });


        document.getElementById('descInput').addEventListener('input', function () {
            let charCount = this.value.length;
            let charCounter = document.getElementById('charCount');
            document.getElementById('afterDescription').textContent = this.value || "Preview here";
            charCounter.textContent = charCount + " / 225";
            charCounter.classList.toggle('warning', charCount >= 225);
        });
    </script>
}
else
{
    <p style="text-align:center;">❌ Error: Content not found.</p>
}
