<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Histoscanner</title>
    <style>
        /* Global Styles */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #80cbc4; /* Updated to match the requested color */
            color: #333;
        }

        h1, h2 {
            margin: 0;
        }

        .content {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: 20px;
            text-align: center;
            height: 100vh;
            box-sizing: border-box;
        }

        .description {
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            max-width: 600px;
            margin-bottom: 20px;
            text-align: center;
        }

        .upload-container {
            background-color: #fff;
            border: 2px dashed #ccc;
            border-radius: 10px;
            width: 100%;
            max-width: 400px;
            padding: 20px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            transition: border-color 0.3s ease;
            position: relative;
            margin-top: 20px; /* Adjusted to make the upload section higher */
        }

            .upload-container:hover {
                border-color: #005792;
            }

            .upload-container.drag-over {
                border-color: #004172;
            }

            .upload-container h3 {
                margin-top: 0;
                font-size: 20px;
                color: #333;
                font-weight: bold;
            }

            .upload-container p {
                font-size: 14px;
                color: #666;
                margin-bottom: 20px;
            }

        .upload-btn {
            display: inline-block;
            padding: 12px 20px;
            font-size: 14px;
            font-weight: bold;
            color: #fff;
            background-color: #005792;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

            .upload-btn:hover {
                background-color: #004172;
            }

        #imageUpload {
            display: none; /* Hide the default input */
        }

        #imagePreview {
            margin-top: 20px;
            height: 300px;
            max-width: 100%;
            display: none;
            border-radius: 10px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
        }

        #label-container {
            margin-top: 20px;
            padding: 10px;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
            width: 80%;
            max-width: 400px;
            text-align: center;
            display: none; /* Hides the label container initially */
        }

    </style>
</head>
<body>
    <!-- Navbar -->
    @await Html.PartialAsync("navbar")

    <!-- Content Section -->
    <div class="content">
        <div class="description">
            <h2>Welcome to the Histoscanner</h2>
            <p>The Histoscanner leverages advanced AI technology to analyze tissue samples with precision and speed. Upload your histology images and gain insights into their composition in seconds!</p>
        </div>

        <div class="upload-container" id="uploadArea">
            <h3>Upload Tissue Image</h3>
            <p>Upload file here</p>
            <label for="imageUpload" class="upload-btn">Choose File</label>
            <input id="imageUpload" type="file" accept="image/*">
        </div>

        <img id="imagePreview" alt="Preview of uploaded image">
        <div id="label-container"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow/tfjs@latest/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@teachablemachine/image@latest/dist/teachablemachine-image.min.js"></script>
    <script>
        const URL = "https://teachablemachine.withgoogle.com/models/MdaDDTctm/";
        let model, labelContainer;

        // Initialize the model
        async function init() {
            const modelURL = URL + "model.json";
            const metadataURL = URL + "metadata.json";

            model = await tmImage.load(modelURL, metadataURL);
            labelContainer = document.getElementById("label-container");
        }

        // Handle file upload and drag-and-drop
        const uploadArea = document.getElementById("uploadArea");
        const imageUpload = document.getElementById("imageUpload");
        const imagePreview = document.getElementById("imagePreview");

        // Highlight the drag area when dragging
        uploadArea.addEventListener("dragover", (e) => {
            e.preventDefault();
            uploadArea.classList.add("drag-over");
        });

        uploadArea.addEventListener("dragleave", () => {
            uploadArea.classList.remove("drag-over");
        });

        // Handle dropped files
        uploadArea.addEventListener("drop", (e) => {
            e.preventDefault();
            uploadArea.classList.remove("drag-over");
            if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                handleFile(e.dataTransfer.files[0]);
            }
        });

        // Handle file input
        imageUpload.addEventListener("change", (e) => {
            if (e.target.files && e.target.files[0]) {
                handleFile(e.target.files[0]);
            }
        });

        // Handle uploaded or dropped file
        function handleFile(file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                imagePreview.src = e.target.result;
                imagePreview.style.display = "block";
                imagePreview.onload = () => predict();
            };
            reader.readAsDataURL(file);
        }

        // Prediction function
        async function predict() {
            labelContainer.innerHTML = "";
            labelContainer.style.display = "block"; // Show the container only when results are available
            const prediction = await model.predict(imagePreview, false);
            let hasHighConfidence = false;

            prediction.forEach((p) => {
                if (p.probability >= 0.90) {
                    hasHighConfidence = true;
                    const result = `${p.className}: ${(p.probability * 100).toFixed(2)}% accurate`;
                    const resultElement = document.createElement("div");
                    resultElement.innerText = result;
                    labelContainer.appendChild(resultElement);
                }
            });

            if (!hasHighConfidence) {
                const warning = document.createElement("div");
                warning.innerText = "Unable to determine tissue type. Please upload a clearer picture or seek a lecturer for help.";
                labelContainer.appendChild(warning);
            }
        }

        // Initialize the model on page load
        window.onload = init;
    </script>
</body>
</html>
