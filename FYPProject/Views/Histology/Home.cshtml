<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Histology</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #80cbc4;
            color: #333;
        }

        .content {
            padding: 30px; /* Increased from 25px */
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* ========== Content Cards ========== */
        .welcome-section,
        .explanation-section {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 18px; /* Slightly rounder corners */
            box-shadow: 0 4px 20px rgba(0,0,0,0.12); /* Deeper shadow */
            max-width: 1100px; /* Increased from 1000px */
            width: 100%; /* Full available width */
            margin-bottom: 35px; /* More spacing between sections */
            padding: 35px; /* Increased from 30px */
        }

        .welcome-section {
            display: flex;
            gap: 35px; /* Increased from 30px */
        }

        .welcome-thumbnail {
            flex-shrink: 0;
            width: 300px; /* Increased from 280px */
            height: auto;
            border-radius: 15px; /* More rounded */
            object-fit: cover;
        }

        .welcome-text h2 {
            color: #00796b;
            font-size: 34px; /* Increased from 32px */
            margin: 0 0 28px 0; /* Slightly more margin */
        }

        .welcome-text p {
            font-size: 18px; /* Increased from 17px */
            line-height: 1.75; /* Better breathing room */
            margin: 0 0 22px 0;
        }

        /* ========== Images Grid ========== */
        .images-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); /* Wider cards */
            gap: 35px; /* Increased from 30px */
            width: 100%;
            max-width: 1400px; /* Wider container */
        }

        .image-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 18px; /* Matches other cards */
            box-shadow: 0 4px 20px rgba(0,0,0,0.12); /* Consistent shadow */
            overflow: hidden;
        }

            .image-card img {
                width: 100%;
                height: 240px; /* Taller images */
                object-fit: cover;
                border-bottom: 1px solid #eee;
            }

        .image-description {
            padding: 22px; /* More padding */
            color: #00796b;
            font-size: 19px; /* Slightly larger */
            font-weight: bold;
            text-align: center;
        }

        /* ========== Mobile Optimization ========== */
        @@media (max-width: 768px) {
            .content

        {
            padding: 25px; /* Reduced from 30px */
        }

        .welcome-section {
            flex-direction: column;
            padding: 28px; /* Fine-tuned padding */
            gap: 28px;
        }

        .welcome-thumbnail {
            max-width: 380px; /* Larger mobile thumbnail */
            margin: 0 auto 28px auto;
        }

        .welcome-text h2 {
            font-size: 30px; /* Balance for mobile */
        }

        .images-section {
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); /* Wider mobile cards */
            gap: 28px;
        }

        .image-card img {
            height: 220px; /* Taller mobile images */
        }

        }

        @@media (max-width: 480px) {
            .welcome-section, .explanation-section

        {
            padding: 22px;
        }

        .welcome-text h2 {
            font-size: 26px; /* Perfect mobile size */
        }

        .images-section {
            grid-template-columns: 1fr; /* Single column */
            gap: 22px;
        }

        .image-card img {
            height: 200px; /* Optimized height */
        }

        }
    </style>
</head>
<body>
    <div class="content">
        <!-- Welcome Section -->
        <div class="welcome-section">
            <img src="/images/WelcomeThumbnail.jpg" alt="Welcome Thumbnail" class="welcome-thumbnail">
            <div class="welcome-text">
                <h2>Welcome to Histology!</h2>
                <p>Explore the fascinating world of tissues with our cutting-edge AI-powered platform. Designed for students and lecturers, this tool leverages artificial intelligence to accurately identify and classify tissue types using histology images.</p>
                <p>By analyzing key features—such as staining intensity, texture, and structural patterns—our platform ensures precise and reliable results.</p>
                <p>Whether you're learning or teaching, this platform offers a fast and intuitive way to explore and understand complex tissue structures. Dive into the future of histology and experience the power of AI-driven insights today!</p>
            </div>
        </div>

        <!-- Explanatory Section -->
        <div class="explanation-section">
            <p>
                Below are the tissue types you will encounter on this site, shown at different magnifications.
                Visit <a href="/Histology/Histopedia" style="color: #00796b; font-weight: bold;">Histopedia</a>
                to learn more about these tissues in detail.
            </p>
        </div>

        <!-- Images Section -->
        <div class="images-section" id="images-section">
            <!-- Images populated dynamically -->
        </div>
    </div>

    <script>
        // JavaScript remains unchanged
        const apiEndpoint = "/api/Histology/Thumbnail";
        const imageDescriptions = [
            "Kidney Thumbnail 100x",
            "Kidney Thumbnail 400x",
            "Lung Thumbnail 100x",
            "Lung Thumbnail 400x"
        ];

        function formatDescription(photoDescription) {
            const parts = photoDescription.split(" ");
            const tissue = parts[0];
            const magnification = parts.slice(2).join(" ");
            return `${tissue} Tissue ${magnification} Magnification`;
        }

        const imagesSection = document.getElementById("images-section");

        async function fetchAndDisplayImages() {
            for (const description of imageDescriptions) {
                try {
                    const response = await fetch(`${apiEndpoint}?photoDescription=${encodeURIComponent(description)}`);
                    if (!response.ok) continue;
                    const image = await response.json();

                    const imageCard = document.createElement("div");
                    imageCard.className = "image-card";

                    const img = document.createElement("img");
                    img.src = image.photo_URL;
                    img.alt = image.photo_Description;

                    const descriptionElement = document.createElement("div");
                    descriptionElement.className = "image-description";
                    descriptionElement.textContent = formatDescription(image.photo_Description);

                    imageCard.appendChild(img);
                    imageCard.appendChild(descriptionElement);
                    imagesSection.appendChild(imageCard);
                } catch (error) {
                    console.error(`Error fetching image: ${error.message}`);
                }
            }
        }

        fetchAndDisplayImages();
    </script>
</body>
</html>