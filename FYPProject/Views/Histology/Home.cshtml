@model List<FYPProject.Models.HomeContent>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Home";
    var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserRole");
}

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #80cbc4;
    }

    .container {
        max-width: 1000px;
        margin: 50px auto;
        background: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        text-align: center;
    }

    .welcome-card {
        background: linear-gradient(to bottom, #e0e0e0, #f5f5f5);
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        margin-bottom: 25px;
        text-align: center;
        border: 1px solid #d0d0d0;
    }

        .welcome-card h2 {
            color: #00695c;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .welcome-card p {
            font-size: 16px;
            color: #333;
            line-height: 1.6;
        }

    .grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
        padding: 20px;
    }

    .grid-item {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        background: white;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease-in-out;
    }

        .grid-item:hover {
            transform: scale(1.03);
        }

        .grid-item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

    .overlay {
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: 16px;
        font-weight: bold;
        padding: 10px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
    }

    .admin-buttons {
        position: absolute;
        bottom: 40px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 10px;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
        z-index: 2;
    }

    .grid-item:hover .admin-buttons {
        opacity: 1;
        visibility: visible;
    }

    .grid-item:hover img {
        opacity: 0.8;
    }

    .admin-button {
        padding: 8px 14px;
        background: #1976d2;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        transition: background 0.3s ease;
    }

    .delete-btn {
        background: #d32f2f;
    }

    .admin-button:hover {
        background: #0d47a1;
    }

    .delete-btn:hover {
        background: #b71c1c;
    }

    @@media (max-width: 768px) {
        .container

    {
        padding: 15px;
        margin: 30px auto;
    }

    .welcome-card {
        padding: 20px;
        margin-bottom: 20px;
    }

    .grid-container {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 15px;
    }

    .grid-item {
        height: auto;
    }

    }

    @@media (max-width: 480px) {
        .grid-container

    {
        grid-template-columns: 1fr;
    }

    .admin-buttons {
        flex-direction: column;
        gap: 5px;
    }

    }
</style>

<div class="container">
    <div class="welcome-card">
        <h2>Welcome to Histology!</h2>
        <p>
            Explore the fascinating world of tissues with our cutting-edge AI-powered platform.
        </p>
    </div>

    <h2>Tissue Details</h2>

    @if (userRole == "1")
    {
        <div class="admin-panel">
            <h3>Admin Panel - Manage Content</h3>
            <a href="/Histology/AddPhoto" class="admin-button">+ Add New Content</a>
        </div>
    }

    <div class="grid-container">
        @if (Model != null && Model.Any())
        {
            @foreach (var content in Model)
            {
                <div class="grid-item">
                    <img src="@content.Url" alt="@content.Description" />
                    @if (userRole == "1")
                    {
                        <div class="admin-buttons">
                            <a asp-controller="Admin" asp-action="UpdatePhoto" asp-route-id="@content.Id" class="admin-button">Edit</a>
                            <a asp-controller="Admin" asp-action="DeletePhoto" asp-route-id="@content.Id" class="admin-button delete-btn">Delete</a>
                        </div>
                    }
                    <div class="overlay">@content.Description</div>
                </div>
            }
        }
        else
        {
            <p style="text-align:center; font-size:18px; color:gray;">No content available.</p>
        }
    </div>
</div>