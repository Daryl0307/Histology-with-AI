<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Histoscanner</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #80cbc4;
            color: #333;
            min-height: 100vh;
        }

        .content {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            box-sizing: border-box;
        }

        .description {
            background-color: rgba(255, 255, 255, 0.95);
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            max-width: 800px;
            width: 100%;
            margin-bottom: 25px;
            text-align: center;
        }

        .upload-container {
            background-color: rgba(255, 255, 255, 0.95);
            border: 2px dashed #00796b;
            border-radius: 15px;
            width: 100%;
            max-width: 500px;
            padding: 30px;
            margin: 20px 0;
            transition: all 0.3s ease;
            text-align: center;
        }

            .upload-container.dragging {
                border-color: #005792;
                background-color: #f0f8ff;
            }

        .upload-btn {
            display: inline-block;
            padding: 12px 25px;
            font-weight: bold;
            color: #fff;
            background-color: #00796b;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            margin-top: 15px;
        }

            .upload-btn:hover {
                background-color: #005792;
            }

        #imageUpload {
            display: none;
        }

        #imagePreview {
            max-width: 400px;
            height: auto;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            display: none;
            margin: 20px 0;
        }

        #label-container {
            background-color: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            padding: 25px;
            width: 100%;
            max-width: 800px;
            margin-top: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            display: none;
        }

        .success-message {
            color: #00796b;
            font-size: 1.2em;
            margin: 15px 0;
        }

        .insights-link {
            display: inline-block;
            padding: 12px 25px;
            background-color: #00796b;
            color: white;
            font-weight: bold;
            text-decoration: none;
            border-radius: 8px;
            margin: 20px 0;
            transition: background-color 0.3s ease;
        }

            .insights-link:hover {
                background-color: #005792;
            }

            .insights-link:active {
                transform: scale(0.98);
            }

        .lightbox {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

            .lightbox.show {
                display: flex;
            }

            .lightbox img {
                max-width: 90%;
                max-height: 90%;
                border-radius: 10px;
                animation: zoomIn 0.3s ease;
            }

        .close-btn {
            position: absolute;
            top: 25px;
            right: 25px;
            color: white;
            font-size: 30px;
            cursor: pointer;
            background: none;
            border: none;
            padding: 10px;
        }

        @@keyframes zoomIn {
            from {
                transform: scale(0.8);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        /* Mobile Layout */
        @@media (max-width: 768px) {
            .content {
                padding: 15px;
            }

            .description {
                padding: 20px;
                margin-bottom: 15px;
            }

            .upload-container {
                padding: 20px;
                margin: 15px 0;
                max-width: 100%;
            }

            .upload-btn {
                padding: 10px 20px;
                font-size: 0.9em;
            }

            #imagePreview {
                max-width: 100%;
                margin: 15px 0;
            }

            #label-container {
                padding: 20px;
                margin-top: 15px;
                border-radius: 12px;
            }

            .success-message {
                font-size: 1.1em;
            }

            .insights-link {
                padding: 10px 20px;
                font-size: 0.9em;
                margin: 15px 0;
            }

            .close-btn {
                top: 15px;
                right: 15px;
                font-size: 24px;
            }

            .lightbox img {
                max-width: 95%;
            }
        }

        @@media (max-width: 480px) {
            .description h2 {
                font-size: 1.5em;
            }

            .description p {
                font-size: 0.9em;
            }

            .upload-container h3 {
                font-size: 1.2em;
            }

            .upload-container p {
                font-size: 0.9em;
            }

            #label-container {
                padding: 15px;
            }

            .success-message {
                font-size: 1em;
            }
        }
    </style>
</head>
<body>
    <div class="content">
        <div class="description">
            <h2>Welcome to the Histoscanner</h2>
            <p>The Histoscanner leverages AI to analyze tissue samples with precision and speed.</p>
            <p>Please allow the model up to 5 seconds to initilize before inputting an image.</p>
        </div>

        <div class="upload-container" id="upload-container">
            <h3>Upload Tissue Image</h3>
            <p>Analyse your tissue sample here!</p>
            <label for="imageUpload" class="upload-btn">Choose File</label>
            <input id="imageUpload" type="file" accept="image/*">
        </div>

        <img id="imagePreview" alt="Preview of uploaded image">
        <div id="label-container"></div>
    </div>

    <!-- Lightbox -->
    <div id="lightbox" class="lightbox">
        <button class="close-btn" onclick="closeLightbox()">✕</button>
        <img id="lightbox-img" src="" alt="Enlarged view">
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow/tfjs@latest/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@teachablemachine/image@latest/dist/teachablemachine-image.min.js"></script>
    <script>
        const URL = "https://teachablemachine.withgoogle.com/models/MdaDDTctm/";
        let model, labelContainer;

        async function init() {
            try {
                console.log("Initializing TensorFlow.js backend...");
                await tf.setBackend('webgl');
                model = await tmImage.load(URL + "model.json", URL + "metadata.json");
                console.log("Model loaded successfully.");
                labelContainer = document.getElementById("label-container");
            } catch (error) {
                console.error("Model initialization failed:", error);
                alert("Failed to load the AI model.");
            }
        }

        const uploadContainer = document.getElementById("upload-container");
        const imageUpload = document.getElementById("imageUpload");

        // Drag and drop files
        uploadContainer.addEventListener("dragover", (e) => {
            e.preventDefault();
            uploadContainer.classList.add("dragging");
        });

        uploadContainer.addEventListener("dragleave", () => {
            uploadContainer.classList.remove("dragging");
        });

        uploadContainer.addEventListener("drop", (e) => {
            e.preventDefault();
            uploadContainer.classList.remove("dragging");
            const file = e.dataTransfer.files[0];
            if (file) handleFileUpload(file);
        });

        imageUpload.addEventListener("change", (e) => {
            if (e.target.files && e.target.files[0]) {
                handleFileUpload(e.target.files[0]);
            }
        });

        function handleFileUpload(file) {
            const reader = new FileReader();
            reader.onload = function (event) {
                const imagePreview = document.getElementById("imagePreview");
                imagePreview.src = event.target.result;
                imagePreview.style.display = "block";
                imagePreview.onload = () => predict();
            };
            reader.readAsDataURL(file);
        }

        async function predict() {
            if (!model) return console.error("Model not loaded.");
            labelContainer.innerHTML = "";
            let hasResults = false;

            const predictions = await model.predict(document.getElementById("imagePreview"));
            predictions.forEach(async (p) => {
                if (p.probability > 0.9) {
                    hasResults = true;
                    const tissueName = p.className.toLowerCase();
                    labelContainer.innerHTML += `
                        <div class="success-message">
                            ${tissueName}: ${(p.probability * 100).toFixed(2)}% accuracy
                        </div>
                        <a href="/Tissue/${tissueName}" class="insights-link">
                            View Detailed Insights for ${tissueName} Tissue
                        </a>
                    `;

                    const response = await fetch(`/api/Histology/GetPhotoUrl?photoDescription=${encodeURIComponent(tissueName)}`);
                    const data = await response.json();
                    const baseUrl = window.location.origin;
                    const imageUrl = data.photo_URL.startsWith("http") ? data.photo_URL : `${baseUrl}${data.photo_URL}`;

                    labelContainer.innerHTML += `
                        <p style="font-weight: bold; margin-top: 20px;">
                            Tissue identification insights:
                        </p>
                        <img src="${imageUrl}"
                             onclick="openLightbox('${imageUrl}')"
                             alt="${data.photo_Description}"
                             style="max-width: 100%; height: auto; margin: 15px auto; display: block; border-radius: 10px; cursor: pointer;">
                    `;
                }
            });

            if (hasResults) {
                labelContainer.style.display = "block";
            }
        }

        function openLightbox(url) {
            const lightbox = document.getElementById("lightbox");
            const lightboxImg = document.getElementById("lightbox-img");
            lightboxImg.src = url;
            lightbox.classList.add("show");
        }

        function closeLightbox() {
            const lightbox = document.getElementById("lightbox");
            lightbox.classList.remove("show");
        }

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeLightbox();
        });

        window.onload = init;
    </script>
</body>
</html>