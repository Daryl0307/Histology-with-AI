<body>


    @if (!isVerificationCodeSent && ViewBag.IsPasswordReset != true)
    {
        <div class="reset-card">
            <img src="@ViewBag.ImageUrl" alt="Logo" class="logo" />
            <p>Enter your email to change your password</p>
            <form method="post" asp-action="SendResetPasswordEmail" asp-controller="Account">
                @Html.AntiForgeryToken()
                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                {
                    <div class="error-message">@Html.Raw(ViewBag.ErrorMessage)</div>
                }
                <input name="email" type="email" class="form-control" placeholder="Enter your email" required />
                <button type="submit" class="btn-primary" id="sendCodeBtn">
                    <span id="btnText">Send Verification Code</span>
                    <div id="customSpinner" class="spinner" style="display: none;"></div>
                </button>


                <p class="footer-link" style="position:relative; top:10px;"> Go back? <a href="/Account/Login">Return to Login</a></p>
            </form>
        </div>
    }
    else if (ViewBag.IsPasswordReset == true)
    {
        <div class="reset-cardpw">
            <img src="@ViewBag.ImageUrl" alt="Logo" class="logo" />
            <p>Reset your password</p>
            <form method="post" asp-action="ResetPassword" asp-controller="Account">
                @Html.AntiForgeryToken()
                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                {
                    <div class="error-messagepw">@Html.Raw(ViewBag.ErrorMessage)</div>
                }
                <div class="password-wrapper">
                    <input id="newPassword" name="newPassword" type="password" class="form-controlpw"
                           placeholder="Enter new password" required minlength="8" maxlength="24"
                           pattern="^(?=.[A-Z])(?=.[0-9])[A-Za-z0-9]{8,24}$"
                           title="Password must be 8-24 characters long, contain at least one uppercase letter, one number, and no symbols." />
                    <i id="toggleNewPasswordIcon" class="fas fa-eye toggle-password"
                       style="position: relative; bottom: 20px; left: 165px;"
                       onclick="togglePasswordVisibility('newPassword', 'toggleNewPasswordIcon')"></i>
                </div>
                <div class="password-wrapper">
                    <input id="confirmPassword" name="confirmPassword" type="password" class="form-controlpw"
                           placeholder="Confirm password" required minlength="8" maxlength="24"
                           pattern="^(?=.[A-Z])(?=.[0-9])[A-Za-z0-9]{8,24}$"
                           title="Password must be 8-24 characters long, contain at least one uppercase letter, one number, and no symbols." />
                    <i id="toggleConfirmPasswordIcon" class="fas fa-eye toggle-password"
                       style="position: relative; bottom: 20px; left: 165px;"
                       onclick="togglePasswordVisibility('confirmPassword', 'toggleConfirmPasswordIcon')"></i>
                </div>
                <button type="submit" class="btn-primarypw">Save Password</button>
            </form>


        </div>
    }
    else
    {
        <div class="reset-card">
            <img src="@ViewBag.ImageUrl" alt="Logo" class="logo" />
            <p>Verify your code</p>
            <p>We have sent a code to your email <b>@maskedEmail</b></p>
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="error-message" style="color: red; font-size: 14px; margin-bottom: 10px;">
                    @Html.Raw(ViewBag.ErrorMessage)
                </div>
            }
            <form method="post" asp-action="VerifyCode" asp-controller="Account">
                @Html.AntiForgeryToken()
                <div class="form-container">
                    <input id="code1" type="text" maxlength="1" class="form-control verification-code-input" required />
                    <input id="code2" type="text" maxlength="1" class="form-control verification-code-input" required />
                    <input id="code3" type="text" maxlength="1" class="form-control verification-code-input" required />
                    <input id="code4" type="text" maxlength="1" class="form-control verification-code-input" required />
                    <input type="hidden" id="hiddenCode" name="code" />
                </div>
                <button type="submit" class="btn-primary">Verify</button>
            </form>
            <div class="footer-link" style="text-align: center; display: flex; justify-content: center; align-items: center; gap: 5px; position:relative; top:5px;">
                <span>Didn’t receive code?</span>
                <form id="resendForm" method="post" asp-action="SendResetPasswordEmail" asp-controller="Account" style="margin: 0;">
                    <input type="hidden" name="email" value="@TempData["UserEmail"]" />
                    <button id="resendCode" type="submit"
                            style="background: none; border: none; color: #007bff; text-decoration: underline; cursor: pointer; padding: 0;">
                        Resend
                    </button>
                </form>
            </div>

            <p id="resendMessage" class="footer-link" style="color: green; display: none;"></p>




            <p class="footer-link" style="position:relative; top:10px;">Go back? <a href="/Account/Login">Return to Login</a></p>
        </div>


    }

    <div id="successModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 1000; justify-content: center; align-items: center;">
        <div style="background: white; padding: 20px; border-radius: 8px; text-align: center; width: 300px;">
            <div style="font-size: 50px; color: green; margin-bottom: 20px;">✔</div>
            <div style="font-size: 18px; margin-bottom: 20px;">Password changed successfully!</div>
            <button onclick="redirectToLogin()" style="background-color: #005792; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer;">Return to Login Page</button>
        </div>
    </div>

</body>
</html>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const inputs = document.querySelectorAll(".verification-code-input");
        const hiddenCode = document.getElementById("hiddenCode");
        const resendButton = document.getElementById("resendCode");
        const resendMessage = document.getElementById("resendMessage");


        inputs.forEach((input, index) => {
            input.addEventListener("input", () => {

                hiddenCode.value = Array.from(inputs).map(i => i.value).join("");


                if (input.value.length === 1 && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
            });

            input.addEventListener("keydown", (e) => {

                if (e.key === "Backspace" && !input.value && index > 0) {
                    inputs[index - 1].focus();
                }
            });
        });


        const verifyForm = document.querySelector('form[asp-action="VerifyCode"]');
        if (verifyForm) {
            verifyForm.addEventListener("submit", (e) => {
                console.log("Submitting concatenated code:", hiddenCode.value);
            });
        }


        if (resendButton) {
            resendButton.addEventListener("click", function (event) {
                event.preventDefault();

                let email = document.querySelector("input[name='email']").value;


                resendButton.innerHTML = "Sending...";
                resendButton.disabled = true;


                fetch("/Account/SendResetPasswordEmail", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: new URLSearchParams({ email: email }),
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        resendMessage.textContent = "A new code has been sent to your email.";
                        resendMessage.style.color = "green";
                        resendMessage.style.display = "block";
                    } else {
                        resendMessage.textContent = "A new code has been sent to your email.";
                        resendMessage.style.color = "green";
                        resendMessage.style.display = "block";
                    }
                })
                .catch(error => {
                    console.error("Resend Error:", error);
                    resendMessage.textContent = "A new code has been sent to your email.";
                    resendMessage.style.color = "green";
                    resendMessage.style.display = "block";
                })
                .finally(() => {

                    setTimeout(() => {
                        resendButton.innerHTML = "Resend";
                        resendButton.disabled = false;
                    }, 3000);
                });
            });
        }
    });


    function togglePasswordVisibility(inputId, iconId) {
        const passwordField = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        if (passwordField.type === 'password') {
            passwordField.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            passwordField.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }


    function redirectToLogin() {
        window.location.href = '/Account/Login';
    }


    document.addEventListener('DOMContentLoaded', () => {
        const showModal = @Html.Raw(ViewBag.ShowSuccessModal?.ToString().ToLower() ?? "false");
        if (showModal) {
            document.getElementById('successModal').style.display = 'flex';
        }
    });

</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sendCodeBtn = document.getElementById("sendCodeBtn");
        const btnText = document.getElementById("btnText");
        const customSpinner = document.getElementById("customSpinner");

        sendCodeBtn.addEventListener("click", function (event) {
            event.preventDefault();
            sendCodeBtn.disabled = true;

            // Show spinner and update text
            btnText.textContent = "Processing...";
            customSpinner.style.display = "inline-block";

            // Submit form after a delay
            setTimeout(() => {
                sendCodeBtn.form.submit();
            }, 200);
        });
    });
</script>