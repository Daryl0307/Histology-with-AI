@{
    ViewData["Title"] = "Logout Confirmation";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<style>
    body {
        background-color: #80cbc4;
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        position: relative; /* Required for absolute positioning */
    }

    .logout-card {
        background: white;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        text-align: center;
        width: 100%;
        max-width: 380px;
        box-sizing: border-box;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%); /* Ensures perfect centering */
    }

    .success-icon {
        font-size: 45px;
        color: #28a745;
        margin-bottom: 10px;
    }

    .logout-card h2 {
        color: #333;
        margin-bottom: 8px;
        font-size: 20px;
        font-weight: bold;
        white-space: normal;
        text-align: center;
    }

    .logout-card p {
        color: #666;
        font-size: 15px;
        text-align: center;
        margin: 5px 0 10px;
        line-height: 1.4;
    }

    .countdown {
        color: #dc3545;
        font-weight: bold;
        font-size: 15px;
        display: inline-block;
        margin-left: 4px;
    }

    .logout-button {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 12px 20px;
        font-size: 15px;
        cursor: pointer;
        border-radius: 5px;
        margin-top: 15px;
        text-decoration: none;
        display: block;
        width: 90%;
        max-width: 220px;
        margin-left: auto;
        margin-right: auto;
        box-sizing: border-box;
    }

        .logout-button:hover {
            background-color: #0056b3;
        }

    /* Mobile Optimization */
    @@media (max-width: 480px) {
        .logout-card

    {
        padding: 20px;
        width: 90%;
        max-width: 100%;
    }

    .logout-card h2 {
        font-size: 18px;
    }

    .logout-card p {
        font-size: 14px;
    }

    .success-icon {
        font-size: 38px;
    }

    .logout-button {
        font-size: 14px;
        padding: 10px;
        width: 100%;
    }

    }
</style>

<script>
    let seconds = 5; 
    function countdown() {
        if (seconds > 0) {
            document.getElementById("countdown").innerText = seconds;
            seconds--;
            setTimeout(countdown, 1000);
        } else {
            window.location.href = '@Url.Action("Home", "Histology")';
        }
    }
    window.onload = countdown;
</script>

<div class="logout-card">
    <i class="fas fa-check-circle success-icon"></i> 
    <h2>You have successfully logged out!</h2>
    <p>Thank you for visiting. You will be redirected to the homepage in <span class="countdown" id="countdown">5</span> seconds.</p>

    <a href="@Url.Action("Home", "Histology")" class="logout-button">Return to Home Now</a>
</div>
