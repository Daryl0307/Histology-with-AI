<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Email</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #80cbc4;
        }

        .container-wrapper {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 100%;
        }

        .login-card {
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.1);
            width: 400px;
            padding: 30px;
            text-align: center;
        }

            .login-card img {
                height: 150px;
                margin-bottom: 20px;
                border-radius: 50%;
            }

        .form-group {
            margin-bottom: 20px;
        }

        .form-control {
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 10px;
            width: 100%;
        }

        .btn-primary {
            background-color: #007bff;
            border: none;
            padding: 12px 20px;
            border-radius: 4px;
            color: #fff;
            font-size: 18px;
            width: 100%;
        }

            .btn-primary:hover {
                background-color: #0056b3;
            }

        .alert {
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container-wrapper">
        <div class="login-card">
            <img src="@ViewBag.imageUrl" alt="Logo" class="logo" />
            <h1>Verify Your Email</h1>
            <p>Enter the 4-digit verification code sent to your email address.</p>

            @if (TempData["Errors"] != null)
            {
                var errors = TempData["Errors"] as Dictionary<string, string>;
                if (errors != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @foreach (var error in errors)
                        {
                            <p>@error.Value</p>
                        }
                    </div>
                }
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["Success"]
                </div>
            }

            <form method="post" action="/Account/VerifyEmail">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <input type="text" id="verificationCode" name="verificationCode" class="form-control" placeholder="Enter Verification Code" required />
                </div>

                <button type="submit" class="btn-primary">Verify</button>
            </form>
            <p>
                Didn’t receive the email?
                <form method="post" action="/Account/ResendVerificationCode" style="display:inline;">
                    <button type="submit" class="btn btn-link p-0 m-0 align-baseline">Resend Code</button>
                </form>
            </p>

        </div>
    </div>
</body>
</html>