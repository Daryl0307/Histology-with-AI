<style>
    .password-wrapper {
        position: relative;
        width: 100%;
    }

        .password-wrapper input {
            width: 100%;
            padding-right: 40px; /* Space for the eye icon */
        }

    .toggle-password {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        font-size: 18px;
        color: #999;
        top:28px;
    }

        .toggle-password:hover {
            color: #007bff;
        }

</style>


<script>

 function openModal(modalId) {
    let modal = document.getElementById(modalId);
    modal.style.display = "flex";

    if (modalId === "usernameModal") {
        document.getElementById("usernameError").textContent = "";
    }
    if (modalId === "emailModal") {
        document.getElementById("emailError").textContent = "";
    }
    if (modalId === "passwordModal") {
        document.getElementById("passwordMatchError").textContent = "";
    }
}

function closeModal(modalId) {
    document.getElementById(modalId).style.display = "none";
}

window.onclick = function (event) {
    let modals = document.querySelectorAll(".custom-modal");
    modals.forEach(modal => {
        if (event.target === modal) {
            modal.style.display = "none";
        }
    });
};

function validateUsernameForm(event) {
    event.preventDefault();

    let newUsername = document.getElementById("newUsername").value.trim();
    let errorElement = document.getElementById("usernameError");

    console.log("Submitting Change Username Request...");

    if (newUsername.length < 6 || newUsername.length > 24 || !/^[a-zA-Z]+$/.test(newUsername)) {
        errorElement.textContent = "Must be 6-24 characters and contain only letters.";
        return false;
    }

    fetch("/Account/UpdateUsername", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({ newUsername: newUsername }),
    })
    .then(response => response.json())
    .then(data => {
        console.log("Username Update Response:", data);

        if (!data.success) {
            errorElement.textContent = data.message;
        } else {
            errorElement.textContent = "";
            closeModal("usernameModal");
            location.reload();
        }
    })
    .catch(error => console.error("Error:", error));

    return false;
}

function validateEmailForm(event) {
    event.preventDefault();

    let newEmail = document.getElementById("newEmail").value.trim();
    let errorElement = document.getElementById("emailError");
    let submitButton = document.querySelector("#emailForm button[type='submit']");
    let loadingSpinner = document.getElementById("loadingSpinner");

    console.log("Submitting Change Email Request...");

       if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(newEmail)) {
        errorElement.textContent = "Invalid email format.";
        return false;
    }

    submitButton.disabled = true;
    submitButton.innerHTML = `<span class="spinner"></span> Processing...`;
    loadingSpinner.style.display = "block";

    fetch("/Account/RequestEmailChange", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({ newEmail: newEmail }),
    })
    .then(response => response.json())
    .then(data => {
        console.log("Email Change Response:", data);

        if (!data.success) {
            errorElement.textContent = data.message;
            submitButton.disabled = false;
            submitButton.innerHTML = "Change Email";
        } else {
            errorElement.textContent = "";
            window.location.href = "/Account/CgEmail";
        }
    })
    .catch(error => {
        console.error("Error:", error);
        errorElement.textContent = "An error occurred. Please try again.";
        submitButton.disabled = false;
        submitButton.innerHTML = "Change Email";
    })
    .finally(() => {
        loadingSpinner.style.display = "none";
    });

    return false;
}

function validatePasswordForm(event) {
    event.preventDefault();

    let currentPassword = document.getElementById("currentPassword").value.trim();
    let newPassword = document.getElementById("newPassword").value.trim();
    let confirmPassword = document.getElementById("confirmPassword").value.trim();

    let currentPasswordError = document.getElementById("currentPasswordError");
    let newPasswordError = document.getElementById("newPasswordError");
    let confirmPasswordError = document.getElementById("passwordMatchError");

    console.log("Submitting Change Password Request...");

    currentPasswordError.textContent = "";
    newPasswordError.textContent = "";
    confirmPasswordError.textContent = "";

    if (!currentPassword || !newPassword || !confirmPassword) {
        currentPasswordError.textContent = "All fields are required.";
        return false;
    }

    if (newPassword !== confirmPassword) {
        confirmPasswordError.textContent = "Passwords must match.";
        return false;
    }

    if (newPassword.length < 8 || newPassword.length > 24 || !/[A-Z]/.test(newPassword) || !/[0-9]/.test(newPassword)) {
        newPasswordError.textContent = "Password must be 8-24 characters, include at least one number, and mix uppercase & lowercase letters.";
        return false;
    }

    fetch("/Account/ChangePassword", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({
            currentPassword: currentPassword,
            newPassword: newPassword,
            confirmPassword: confirmPassword
        }),
    })
    .then(response => response.json())
    .then(data => {
        console.log("Change Password Response:", data);

        if (!data.success) {
            if (data.field === "currentPassword") {
                currentPasswordError.textContent = data.message;
            } else if (data.field === "newPassword") {
                newPasswordError.textContent = data.message;
            } else if (data.field === "confirmPassword") {
                confirmPasswordError.textContent = data.message;
            }
        } else {
            // Clear error messages
            currentPasswordError.textContent = "";
            newPasswordError.textContent = "";
            confirmPasswordError.textContent = "";

            // Display success message
            showSuccessMessage("Your password has been successfully updated!");

            // Close modal after a short delay
            setTimeout(() => {
                closeModal("passwordModal");
                location.reload(); // Refresh to show updated session state
            }, 2000);
        }
    })
    .catch(error => console.error("Error:", error));

    return false;
}

// Function to show success message dynamically
function showSuccessMessage(message) {
    let successMessageDiv = document.createElement("div");
    successMessageDiv.className = "alert success";
    successMessageDiv.id = "successMessage";
    successMessageDiv.textContent = message;

    document.body.prepend(successMessageDiv); // Insert at the top of the page

    // Auto-hide after 5 seconds
    setTimeout(() => {
        successMessageDiv.style.opacity = "0";
        setTimeout(() => successMessageDiv.remove(), 500);
    }, 5000);
}

</script>

<script>
    function togglePassword(inputId, iconId) {
        const passwordField = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        if (passwordField.type === 'password') {
            passwordField.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            passwordField.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }


</script>





