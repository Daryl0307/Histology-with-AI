@model FYPProject.Models.User_Info

@{
    ViewData["Title"] = "User Profile";
}

<!-- Main Profile Section -->
<div class="profile-page">
    <!-- Profile Box -->
    <div class="profile-container">
        <table class="profile-table">
            <tr>
                <td class="label">Username:</td>
                <td class="value">@Model.Username</td>
            </tr>
            <tr>
                <td class="label">Email:</td>
                <td class="value">@Model.Email</td>
            </tr>
            <tr>
                <td class="label">Role:</td>
                <td class="value">
                    @(Model.Role_Status == 0 ? "Student" : Model.Role_Status == 1 ? "Admin" : "Unknown")
                </td>
            </tr>
        </table>
    </div>
</div>

<!-- CSS Styling -->
<style>
    /* Set the background to match Histoscanner */
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background-color: #90B2B8;
        color: #333;
    }

    /* Prevents layout shift on navbar */
    .profile-page {
        display: flex;
        justify-content: center;
        align-items: flex-start; /* Keeps navbar at the top */
        padding-top: 50px; /* Adjust to avoid overlapping */
    }

    /* Profile Card */
    .profile-container {
        background-color: #ffffff;
        border-radius: 12px;
        width: 100%;
        max-width: 350px;
        padding: 25px;
        box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.1);
        text-align: left;
    }

    /* Profile Table Styling */
    .profile-table {
        width: 100%;
        border-collapse: collapse;
    }

        .profile-table tr {
            border-bottom: 1px solid #ddd;
        }

        .profile-table td {
            padding: 12px;
            font-size: 16px;
        }

    .label {
        font-weight: bold;
        width: 40%;
        color: #002b5c;
    }

    .value {
        font-weight: bold;
        color: #005792;
    }
</style>
