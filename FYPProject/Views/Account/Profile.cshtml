

@model FYPProject.Models.User_Info

@{
    ViewData["Title"] = "User Profile";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert success" id="successMessage">@TempData["SuccessMessage"]</div>
    <script>
        setTimeout(function () {
            document.getElementById("successMessage").style.display = "none";
        }, 5000); // Hide the success message after 5 seconds
    </script>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert error">@TempData["ErrorMessage"]</div>
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />

<!-- Main Profile Section -->
<div class="profile-page">
    <!-- Updated Profile Header Section -->
    <div class="profile-header">
        <h1 class="profile-title">Account Settings</h1>
        <div class="title-decoration"></div>
    </div>
    <div id="loadingSpinner">
        <span class="spinner"></span> Processing...
    </div>
    <div class="profile-container">
        <div class="profile-section">
            <div class="profile-item">
                <div class="item-label">Username</div>
                <div class="item-value">@Model.Username</div>
                <button class="edit-button" onclick="openModal('usernameModal')">
                    <svg class="edit-icon" viewBox="0 0 24 24">
                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                    </svg>
                </button>
            </div>

            <div class="profile-item">
                <div class="item-label">Email</div>
                <div class="item-value">
                    @Model.Email
                    <span class="verification-badge">Verified</span>
                </div>
                <button class="edit-button" onclick="openModal('emailModal')">
                    <svg class="edit-icon" viewBox="0 0 24 24">
                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                    </svg>
                </button>
            </div>

            <div class="profile-item">
                <div class="item-label">Password</div>
                <div class="item-value">••••••••</div>
                <button class="edit-button" onclick="openModal('passwordModal')">
                    <svg class="edit-icon" viewBox="0 0 24 24">
                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                    </svg>
                </button>
            </div>

            <div class="profile-item">
                <div class="item-label">Account Role</div>
                <div class="item-value role-tag @(Model.Role_Status == 1 ? "administrator" : "standard-user")">
                    @(Model.Role_Status == 1 ? "Administrator" : "Standard User")
                </div>
            </div>
        </div>
    </div>
</div>

<div id="usernameModal" class="custom-modal">
    <div class="modal-container">
        <div class="modal-header">
            <h3>Update Username</h3>
            <span class="close-modal" onclick="closeModal('usernameModal')">&times;</span>
        </div>
        <form id="usernameForm" onsubmit="return validateUsernameForm(event);">
            <div class="modal-body">
                <div class="input-group">
                    <label>New Username</label>
                    <input type="text" id="newUsername" name="newUsername" class="form-input" required>
                    <div class="input-error" id="usernameError"></div> <!-- Error will display here -->
                </div>
                <div class="modal-actions">
                    <button type="button" class="action-btn secondary" onclick="closeModal('usernameModal')">Cancel</button>
                    <button type="submit" class="action-btn primary">Save Changes</button>
                </div>
            </div>
        </form>

    </div>
</div>





<div id="emailModal" class="custom-modal">
    <div class="modal-container">
        <div class="modal-header">
            <h3>Update Email Address</h3>
            <span class="close-modal" onclick="closeModal('emailModal')">&times;</span>
        </div>
        <form id="emailForm" onsubmit="return validateEmailForm(event);">
            <div class="modal-body">
                <div class="input-group">
                    <label>New Email</label>
                    <input type="email" id="newEmail" name="newEmail" class="form-input" required>
                    <div class="input-error" id="emailError"></div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="action-btn secondary" onclick="closeModal('emailModal')">Cancel</button>
                    <button type="submit" class="action-btn primary">Change Email</button>
                </div>
            </div>
        </form>

    </div>
</div>


<div id="passwordModal" class="custom-modal">
    <div class="modal-container">
        <div class="modal-header">
            <h3>Change Password</h3>
            <span class="close-modal" onclick="closeModal('passwordModal')">&times;</span>
        </div>

        <form id="passwordForm" onsubmit="return validatePasswordForm(event);">
            <div class="modal-body">
                <div class="input-group">
                    <label>Current Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="currentPassword" name="currentPassword" class="form-input" required>
                        <i id="toggleCurrentPassword" class="fas fa-eye toggle-password" onclick="togglePassword('currentPassword', 'toggleCurrentPassword')"></i>
                    </div>

                    <div class="input-error" id="currentPasswordError"></div>
                </div>

                <div class="input-group">
                    <label>New Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="newPassword" name="newPassword" class="form-input" required>
                        <i id="toggleNewPassword" class="fas fa-eye toggle-password" onclick="togglePassword('newPassword', 'toggleNewPassword')"></i>
                    </div>
                    <div class="input-error" id="newPasswordError"></div>
                </div>

                <div class="input-group">
                    <label>Confirm New Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" required>
                        <i id="toggleConfirmPassword" class="fas fa-eye toggle-password" onclick="togglePassword('confirmPassword', 'toggleConfirmPassword')"></i>
                    </div>
                    <div class="input-error" id="passwordMatchError"></div>
                </div>

                <div class="password-rules">
                    <span>Password Requirements:</span>
                    <ul>
                        <li>8-24 characters</li>
                        <li>At least one number</li>
                        <li>Mix of uppercase and lowercase</li>
                        <li><span id="matchRule" style="color: red;">Passwords must match</span></li>
                    </ul>
                </div>

                <div class="modal-actions">
                    <button type="button" class="action-btn secondary" onclick="closeModal('passwordModal')">Cancel</button>
                    <button type="submit" class="action-btn primary">Save Password</button>
                </div>
            </div>
        </form>
    </div>
</div>




<style>
