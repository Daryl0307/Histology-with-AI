<body>

   

    <div class="container mt-4">
        <h2 class="header" style="font-weight:bold; position:relative; bottom:50px;">Control Panel</h2>

       
        <div class="d-md-none mobile-actions smallmobilebutton" style="position:relative; bottom:90px; left:220px; width:45%;">
            <button id="editButton" class="btn btn-primary mobilesmallsize">
                Edit
                <span id="cancelEdit" class="text-danger" style="display: none; margin-right:-40px; cursor: pointer; position:relative; bottom:95px;">❌</span>
            </button>
            <button id="deleteButton" class="btn btn-danger mobilesmallsize">
                Delete
                <span id="cancelDelete" class="text-danger" style="display: none; cursor: pointer;">❌</span>
            </button>
        </div>

        <table id="userTable" class="table table-striped table-bordered mobile_table mobile_dataTable" style="white-space:nowrap;">
            <thead>
                <tr>
                    <th>No.</th>
                    <th>Username</th>
                    <th>Admin Access</th>
                    <th>Email</th>
                    <th style="width: 80px;">Edit</th>
                    <th style="width: 80px;">Delete</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
               $(document).ready(function () {
            // Initialize DataTable
            const table = $('#userTable').DataTable({
                destroy: true,
                columnDefs: [{ targets: 0, searchable: false, orderable: false }],
                order: [],
                rowCallback: function (row, data, index) {
                    const pageInfo = table.page.info();
                    const rowNumber = pageInfo.start + index + 1;
                    $('td:eq(0)', row).html(rowNumber);
                }
            });

            // Fetch user data from backend
            fetch('/ControlPanel/GetUserInfo')
                .then(response => response.json())
                .then(data => {
                    data.forEach(user => {
                        table.row.add([
                            "",
                            user.username || "N/A",
                            user.adminAccess || "",
                            user.email || "No Email",
                            `<i class="fas fa-edit edit-btn" data-user-id="${user.userId}" title="Edit" style="cursor:pointer;"></i>`,
                            `<i class="fas fa-trash-alt delete-btn" data-user-id="${user.userId}" title="Delete" style="cursor:pointer;"></i>`
                        ]).draw(false);
                    });
                })
                .catch(error => console.error("Error fetching user data:", error));

            // Desktop Edit Button Click
            $('#userTable tbody').on('click', '.edit-btn', function () {
                const userId = $(this).data('user-id');
                if (userId) {
                    window.location.href = `/ControlPanel/ControlPanelEdit?userId=${userId}`;
                } else {
                    alert("User ID not found.");
                }
            });

            // Desktop Delete Button Click
            $('#userTable tbody').on('click', '.delete-btn', function () {
                const row = $(this).closest('tr');
                const userId = $(this).data('user-id');

                if (confirm(`Are you sure you want to delete this user?`)) {
                    fetch('/ControlPanel/DeleteUser', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ userId: userId })
                    }).then(response => {
                        if (response.ok) {
                            table.row(row).remove().draw();
                            alert(`User deleted successfully.`);
                        } else {
                            alert(`Failed to delete user.`);
                        }
                    }).catch(error => console.error("Error deleting user:", error));
                }
            });

     
            let editMode = false;
            let deleteMode = false;
            let editTapTimeout, deleteTapTimeout;

            const editBtn = $('#editButton');
            const deleteBtn = $('#deleteButton');

         
            const cancelEditBtn = $('<span class="text-danger" id="cancelEdit" style="display: none; margin-right:-33px; cursor: pointer; position:relative; bottom:95px;">❌</span>');
            $('.mobile-actions').prepend(cancelEditBtn);

       
            editBtn.on('click', function () {
                editMode = true;
                deleteMode = false;
                cancelEditBtn.show();

                // Change button colors
                editBtn.addClass("edit-active").removeClass("default-btn");
                deleteBtn.removeClass("delete-active").addClass("default-btn");
            });

            // When Delete button is clicked
            deleteBtn.on('click', function () {
                deleteMode = true;
                editMode = false;
                cancelEditBtn.show(); // Show cancel button even when pressing delete

                // Change button colors
                deleteBtn.addClass("delete-active").removeClass("default-btn");
                editBtn.removeClass("edit-active").addClass("default-btn");
            });

            // Handle Clicking the Cancel (❌) for Edit/Delete
            cancelEditBtn.on('click', function () {
                editMode = false;
                deleteMode = false;
                cancelEditBtn.hide();
                editBtn.removeClass("edit-active").addClass("default-btn");
                deleteBtn.removeClass("delete-active").addClass("default-btn");
            });

            // Handle Double Tap to Cancel Edit
            editBtn.on("dblclick", function () {
                editMode = false;
                cancelEditBtn.hide();
                editBtn.removeClass("edit-active").addClass("default-btn");
            });

            // Handle Double Tap to Cancel Delete
            deleteBtn.on("dblclick", function () {
                deleteMode = false;
                cancelEditBtn.hide();
                deleteBtn.removeClass("delete-active").addClass("default-btn");
            });

            // Handle Table Row Click in Mobile Mode
            $('#userTable tbody').on('click', 'tr', function () {
                const row = $(this);
                const userId = row.find('.edit-btn').data('user-id');

                if (editMode && userId) {
                    window.location.href = `/ControlPanel/ControlPanelEdit?userId=${userId}`;
                } else if (deleteMode && userId) {
                    if (confirm(`Are you sure you want to delete this user?`)) {
                        fetch('/ControlPanel/DeleteUser', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ userId: userId })
                        }).then(() => table.row(row).remove().draw());
                    }
                }
            });
        });

    </script>


</body>
