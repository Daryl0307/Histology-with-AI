    <div class="wnd-page l-page cs-gray ac-none t-t-fs-m t-t-fw-m t-t-sp-n t-t-d-n t-s-fs-m t-s-fw-l t-s-sp-n t-s-d-n t-p-fs-m t-p-fw-m t-p-sp-n t-h-fs-m t-h-fw-m t-h-sp-n t-bq-fs-m t-bq-fw-m t-bq-sp-n t-bq-d-q t-btn-fw-l t-nav-fw-l t-pd-fw-l t-nav-tt-n">

        <div>


            <div>
                <h2 style="margin-top:10px;">Control Panel</h2>
                <table id="userTable" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Username</th>
                            <th>Admin Access</th>
                            <th>Email</th>
                            <th style="width: 80px;">Edit</th>
                            <th style="width: 80px;">Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>



            <!-- DataTable HTML END -->

            <footer class="l-f cf">
                <!-- Existing footer code -->
            </footer>
        </div>
    </div>

    <!-- Existing scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            const table = $('#userTable').DataTable({
                destroy: true,
                columnDefs: [
                    { targets: 0, searchable: false, orderable: false },
                ],
                order: [],
                rowCallback: function (row, data, index) {
                    const pageInfo = table.page.info();
                    const rowNumber = pageInfo.start + index + 1;
                    $('td:eq(0)', row).html(rowNumber);
                }
            });


            fetch('/ControlPanel/GetUserInfo')
                .then(response => response.json())
                .then(data => {
                    console.log("Parsed data:", data);

                    data.forEach(user => {
                        console.log("Adding row:", {
                            userId: user.userId,
                            username: user.username,
                            adminAccess: user.adminAccess,
                            email: user.email
                        });

                        table.row.add([
                            "",
                            user.username || "N/A",
                            user.adminAccess || "",
                            user.email || "No Email",
                            `<i class="fas fa-edit edit-btn" data-user-id="${user.userId}" title="Edit" style="cursor:pointer;"></i>`,
                            `<i class="fas fa-trash-alt delete-btn" data-user-id="${user.userId}" title="Delete" style="cursor:pointer;"></i>`
                        ]).draw(false);
                    });
                })
                .catch(error => console.error("Error fetching user data:", error));


            $('#userTable tbody').on('click', '.delete-btn', function () {
                const row = $(this).closest('tr');
                const userId = $(this).data('user-id');


                if (confirm(`Are you sure you want to delete this user?`)) {
                    fetch('/ControlPanel/DeleteUser', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ userId: userId })
                    })
                        .then(response => {
                            if (response.ok) {
                                table.row(row).remove().draw();
                                alert(`User with ID ${userId} has been deleted successfully.`);
                            } else {
                                alert(`Failed to delete user with ID ${userId}.`);
                            }
                        })
                        .catch(error => {
                            console.error("Error deleting user:", error);
                            alert(`An error occurred while deleting the user.`);
                        });
                }
            });


            $('#userTable tbody').on('click', '.edit-btn', function () {
                const userId = $(this).data('user-id');
                if (userId) {
                    window.location.href = `/ControlPanel/ControlPanelEdit?userId=${userId}`;
                } else {
                    alert("User ID not found for this row.");
                }
            });
        });
    </script>



