<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Control Panel Edit</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #90B2B8;
        }

        .container {
            background-color: #35dc96;
            border-radius: 50px;
            box-shadow: rgba(240, 46, 170, 0.4) -5px 5px, rgba(240, 46, 170, 0.3) -10px 10px, rgba(240, 46, 170, 0.2) -15px 15px, rgba(240, 46, 170, 0.1) -20px 20px, rgba(240, 46, 170, 0.05) -25px 25px;
            max-width: 600px;
            padding: 30px;
            margin: auto;
            margin-top: 136px;
        }

        .word {
            font-weight: bold;
        }

        .form-control {
            width: 100%;
            border-radius: 5px;
        }

        .form-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

            .form-actions .reset-password {
                justify-self: flex-start;
            }

            .form-actions .save-cancel {
                display: flex;
                gap: 6px;
            }

        @@media (min-width:1px) and (max-width: 399px) {
            .mobilesmallsize {
                font-size: 11px;
            }
        }
    </style>
</head>
<body>
    <div class="container mt-5" style="position:relative; bottom:25px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); background-color:white;">
        <form id="editForm">
            <div class="mb-3">
                <label for="username" class="form-label word">Username</label>
                <input type="text" id="username" class="form-control">
            </div>
            <div class="mb-3">
                <label class="form-label word">Admin Access</label>
                <div>
                    <input type="radio" id="adminYes" name="adminAccess" value="yes"> <label for="adminYes">Yes</label> &nbsp;&nbsp;
                    <input type="radio" id="adminNo" name="adminAccess" value="no">
                    <label for="adminNo">No</label>
                </div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label word">Email</label>
                <input type="email" id="email" class="form-control">
            </div>
            <div class="form-actions word">
                <button type="button" class="btn btn-danger reset-password mobilesmallsize" data-bs-toggle="modal" data-bs-target="#resetPasswordModal">
                    Reset Password
                </button>

                <div class="save-cancel word">
                    <button type="submit" class="btn btn-primary mobilesmallsize">Save</button>
                    <a href="/ControlPanel/ControlPanel" class="btn btn-secondary mobilesmallsize">Cancel</a>
                </div>
            </div>
        </form>
    </div>
    <div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="resetPasswordModalLabel">Confirm Password Reset</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to reset the password for this user?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmResetPassword">Confirm</button>
                </div>
            </div>
        </div>
    </div>
    <div id="notification" style="display: none; position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
        background-color: #28a745; color: white; padding: 10px 20px; border-radius: 5px; z-index: 1000;">
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
             $(document).ready(function () {
            const userId = new URLSearchParams(window.location.search).get('userId');
            console.log("Editing user with ID:", userId);


            function showNotification(message, isError = false) {
                console.log("Showing notification:", message);

                const notification = $('#notification');
                notification.text(message);
                notification.css({
                    'background-color': isError ? '#dc3545' : '#28a745',
                    'color': 'white',
                    'padding': '10px 20px',
                    'border-radius': '5px',
                    'text-align': 'center',
                    'position': 'fixed',
                    'top': '20px',
                    'left': '50%',
                    'transform': 'translateX(-50%)',
                    'z-index': '1000',
                    'display': 'block'
                });

                setTimeout(() => {
                    notification.fadeOut();
                }, 3000);
            }


            fetch(`/ControlPanel/GetUserDetails?userId=${userId}`)
                .then(response => response.json())
                .then(data => {
                    $('#username').val(data.username || '');
                    $('#email').val(data.email || '');
                    if (data.adminAccess === 'yes') {
                        $('#adminYes').prop('checked', true);
                    } else {
                        $('#adminNo').prop('checked', true);
                    }
                })
                .catch(error => console.error("Error fetching user details:", error));


            $('.reset-password').on('click', function () {
                console.log("Reset Password button clicked");
                $('#resetPasswordModal').modal('show');
            });


            $(document).on('click', '#confirmResetPassword', function () {
                console.log("Confirm Reset Password button clicked");

                fetch(`/ControlPanel/ResetPassword?userId=${userId}`, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => {
                    console.log("Fetch Response:", response);
                    if (!response.ok) {
                        throw new Error("Server returned an error!");
                    }
                    return response.json();
                })
                .then(result => {
                    console.log("Reset password success:", result);

                    $('#resetPasswordModal').modal('hide');
                    showNotification(result.message);
                })
                .catch(error => {
                    console.error("Error resetting password:", error);
                    showNotification("Failed to reset password!", true);
                });
            });


            $('#editForm').off('submit').on('submit', function (e) {
                e.preventDefault();

                const username = $('#username').val();
                const email = $('#email').val();
                const roleStatus = $('input[name="adminAccess"]:checked').val();

                fetch(`/ControlPanel/UpdateUser`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        userId: parseInt(userId),
                        username: username,
                        roleStatus: roleStatus,
                        email: email,
                    }),
                })
                .then(response => response.json())
                .then(result => {
                    showNotification(result.message);
                })
                .catch(error => {
                    console.error("Error updating user:", error);
                    showNotification("Failed to save changes!", true);
                });
            });


            $('body').append('<div id="notification"></div>');
        });


    </script>
</body>
</html>
