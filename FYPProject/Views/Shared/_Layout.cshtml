<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Learn Histology with AI</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

@RenderSection("MoreScripts", required: false)


@RenderSection("Scripts", required: false)
<body>
    
    @await Component.InvokeAsync("Navbar")

   
    <main class="content">
        @RenderBody()
    </main>

    

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .content {
            margin: 20px;
            padding: 20px;
        }

        .footer {
            text-align: center;
            padding: 10px;
            background-color: #f0f0f0;
            margin-top: 20px;
        }
    </style>
</body>
</html>
