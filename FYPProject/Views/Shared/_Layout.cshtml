<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Learn Histology with AI</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<!-- Custom Page-Level Scripts (DataTables, jQuery, etc.) -->
@RenderSection("MoreScripts", required: false)

<!-- General Site-Wide Scripts -->
@RenderSection("Scripts", required: false)
<body>
    <!-- Include Navbar -->
    @await Component.InvokeAsync("Navbar")

    <!-- Main Content -->
    <main class="content">
        @RenderBody()
    </main>

    

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .content {
            margin: 20px;
            padding: 20px;
        }

        .footer {
            text-align: center;
            padding: 10px;
            background-color: #f0f0f0;
            margin-top: 20px;
        }
    </style>
</body>
</html>
