@using FYPProject.Models

@model List<QuizStatistics>
@{
    ViewData["Title"] = "Quiz Statistics";
}
@section MoreScripts {
    <link href="~/lib/datatables/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#jsTable').DataTable({
                paging: true,
                ordering: true,
                info: true,
                lengthChange: true,
                pageLength: 5,
                stateSave: true,
                lengthMenu: [[5, 7, -1], [5, 7, "All"]],
                searching: false
            });
        });
    </script>
}

<!DOCTYPE html>
<html>
<head>
    <title>Interactive Quizzes</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="icon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href='https://fonts.googleapis.com/css2?family=Raleway:wght@400;600&display=swap' rel='stylesheet'>
    <link href="~/css/HistoQuiz.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .chart-container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 200px; /* Adjust height as needed */
        }
    </style>
</head>
<body>
    @await Html.PartialAsync("navbar")
    <div class="container mt-5">
        <div class="big-card">
            <div class="container mt-4">
                <h2 class="text-center">@ViewBag.QuizCategory Quiz Statistics</h2>

                <div class="row text-center">
                    <div class="col-md-4">
                        <div class="stats-card shadow-sm bg-white p-4">
                            <h3>Completion Rate</h3>
                            <div class="chart-container">
                                <canvas id="userAttemptPercent" width="200" height="200"></canvas>
                                <p class="card-text">Total User Attempted: <span class="stats-card">@ViewBag.userAttemptPercent%</span></p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="stats-card shadow-sm bg-white p-4">
                            <h3>Average Score</h3>
                            <div class="chart-container">
                                <canvas id="scoreChartAvgScore" width="200" height="200"></canvas>
                                <p class="card-text">Average Score: <span class="stats-card">@ViewBag.avgScore</span></p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="stats-card shadow-sm bg-white p-4">
                            <h3>Top Scorer</h3>
                            <div class="chart-container">
                                <canvas id="scoreChartTopScorer" width="200" height="200"></canvas>
                                <p class="card-text">Top Scorer: <span class="stats-card">@ViewBag.HighScoreUser</span></p>
                            </div>
                        </div>
                    </div>

                </div>

                <h3 class="mt-4">Student Ranking</h3>

                <div class="card mt-4">
                    <div class="table-responsive">
                        <table id="jsTable" class="table table-bordered table-striped">
                            <thead class="table-header">
                                <tr>
                                    <th scope="col">Student</th>
                                    <th scope="col">Score</th>
                                    <th scope="col">Date</th>

                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var statistics in Model)
                                    {
                                        <tr>
                                            <td>@statistics.Username</td>
                                            <td>@statistics.Score</td>
                                            <td>@statistics.DateAttempted.ToString("yyyy-MM-dd")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="7" class="text-center">No Attempts.</td></tr>

                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>

        document.addEventListener("DOMContentLoaded", function () {
            // Completion rate chart
            var userAttemptPercent = parseFloat('@ViewBag.userAttemptPercent') || 0;
            var ctxCompletion = document.getElementById('userAttemptPercent').getContext('2d');
            var scoreChartCompletion = new Chart(ctxCompletion, {
                type: 'doughnut',
                data: {
                    labels: ['Completed', 'Remaining'],
                    datasets: [{
                        data: [userAttemptPercent, (100 - userAttemptPercent)],
                        backgroundColor: ['#28a745', '#dc3545'],
                        hoverBackgroundColor: ['#218838', '#c82333']
                    }]
                },
                options: {
                    responsive: false,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: function (tooltipItem) {
                                    return tooltipItem.raw.toFixed(2) + "%";
                                }
                            }
                        }
                    }
                }
            });

            // Average Score chart
            var avgScore = parseFloat('@ViewBag.avgScore') || 0;
            var ctxAvgScore = document.getElementById('scoreChartAvgScore').getContext('2d');
            var scoreChartAvgScore = new Chart(ctxAvgScore, {
                type: 'doughnut',
                data: {
                    labels: ['Score', 'Remaining'],
                    datasets: [{
                        data: [avgScore, (100 - avgScore)],
                        backgroundColor: ['#007bff', '#dc3545'],
                        hoverBackgroundColor: ['#0056b3', '#c82333']
                    }]
                },
                options: {
                    responsive: false,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: function (tooltipItem) {
                                    return tooltipItem.raw.toFixed(2) + "%";
                                }
                            }
                        }
                    }
                }
            });

            // Top Scorer chart (updated)
            var topScorerScore = parseFloat('@ViewBag.HighScore') || 0;  // Get the top scorer's score, fallback to 0 if undefined or NaN
            var ctxTopScorer = document.getElementById('scoreChartTopScorer').getContext('2d');
            var scoreChartTopScorer = new Chart(ctxTopScorer, {
                type: 'doughnut',
                data: {
                    labels: ['Top Score', 'Remaining'],
                    datasets: [{
                        data: [topScorerScore, (100 - topScorerScore)],
                        backgroundColor: ['#ffc107', '#dc3545'],
                        hoverBackgroundColor: ['#e0a800', '#c82333']
                    }]
                },
                options: {
                    responsive: false,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: function (tooltipItem) {
                                    return tooltipItem.raw.toFixed(2) + "%";
                                }
                            }
                        }
                    }
                }
            });

        });

    </script>

</body>
</html>
