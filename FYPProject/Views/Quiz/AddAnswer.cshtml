@model FYPProject.Models.Answer

<head>
    <meta charset="UTF-8">
    <link href="~/css/AddQuiz.css" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Answer</title>
    <style>
        /* Applying the requested CSS styles */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #80cbc4;
            color: #333;
        }

        form {
            max-width: 900px;
            margin: 0 auto;
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        label {
            display: inline-block;
            margin-bottom: 10px;
            font-weight: bold;
        }

        input[type="text"], select, input[type="file"] {
            width: 100%;
            padding: 8px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        input[type="radio"] {
            margin-right: 5px;
        }

        .file-input-container {
            display: flex;
            align-items: center;
        }

            .file-input-container input[type="file"] {
                width: auto;
                margin-right: 10px;
            }

            .file-input-container button {
                background-color: #e74c3c;
                color: white;
                border: none;
                padding: 5px 10px;
                cursor: pointer;
                border-radius: 5px;
            }

                .file-input-container button:hover {
                    background-color: #c0392b;
                }

        #image-preview {
            max-width: 200px;
            max-height: 200px;
            margin: 10px 0;
            display: none;
        }

        .answers-container {
            margin-bottom: 20px;
        }

        .Answer {
            margin-bottom: 15px;
        }

            .Answer input[type="text"], .marks-input {
                width: 70%;
            }

        .marks-input {
            display: none;
            width: 20%;
            margin-left: 10px;
        }

        .marks-label {
            display: inline;
        }

        #total-marks-container {
            margin-top: 20px;
            font-weight: bold;
        }

        button[type="submit"] {
            background-color: #3498db;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            width: 100%;
        }

            button[type="submit"]:hover {
                background-color: #2980b9;
            }

        .text-danger {
            color: red;
        }
    </style>
</head>
<body>
    <form id="quiz-form" asp-controller="Quiz" asp-action="AddAnswer" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="AnswerId" />
        <input type="hidden" asp-for="QuestionId" value="@ViewBag.QuestionId" />

        <label asp-for="AnswerText">Answer:</label>
        <input type="text" id="AnswerText" asp-for="AnswerText" name="AnswerText" required>
        <span asp-validation-for="AnswerText" class="text-danger"></span>

        <label asp-for="Is_Correct">
            <input type="checkbox" id="Is_Correct" asp-for="Is_Correct" name="Is_Correct" value="true" onclick="toggleMarksField()">
            Correct Answer
        </label>
        <span asp-validation-for="Is_Correct" class="text-danger"></span>

        <div id="marks-container" style="display: none;">
            <label asp-for="Marks" class="marks-label">Marks:</label>
            <input type="number" id="Marks" asp-for="Marks" name="Marks" min="0" step="0.5" value="0" class="marks-input">
            <span asp-validation-for="Marks" class="text-danger"></span>
        </div>

        <button type="submit">Submit</button>
    </form>



    <script>
        // Function to toggle the visibility of the Marks input field based on the checkbox state
        function toggleMarksField() {
            var marksContainer = document.getElementById('marks-container');
            var isCorrectChecked = document.getElementById('Is_Correct').checked;

            // Toggle the visibility of marks input based on checkbox state
            if (isCorrectChecked) {
                marksContainer.style.display = 'block';
            } else {
                marksContainer.style.display = 'none';
            }
        }

        // Initial check in case the page is loaded with the checkbox already checked
        toggleMarksField();

        // Get the question type and number of correct answers from ViewBag
        var questionType = '@ViewBag.QuestionType';
        var noOfCorrectAnswer = '@ViewBag.NoOfCorrectAnswer';

        // Disable the checkbox for the correct answer if question type is Radio or Dropdown and there is already 1 correct answer
        if ((questionType === 'Multiple Choice (Radio)' || questionType === 'Multiple Choice (Dropdown)') && noOfCorrectAnswer == 1) {
            var checkbox = document.getElementById('Is_Correct');
            checkbox.disabled = true;  // Disable checkbox
            checkbox.title = "Only 1 correct answer allowed for this question type."; // Show title with explanation
            checkbox.checked = false;  // Uncheck the checkbox if disabled
            document.getElementById('marks-container').style.display = 'none';  // Hide Marks input when checkbox is disabled
        }
    </script>
</body>
