@model FYPProject.Models.QuizViewModel

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Quiz</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- Custom CSS -->
    <link href="~/css/AddQuiz.css" rel="stylesheet" />

    <style>
        .form-check-input {
            width: 20px;
            height: 20px;
            border: 2px solid #000;
        }
    </style>
</head>
<body style="background-color: #80cbc4;">
    <div class="container mt-5">
        <form id="quiz-form" class="p-4 bg-white rounded shadow" asp-controller="Quiz" asp-action="AddQuiz" method="post" enctype="multipart/form-data">
            <h2 class="text-center mb-4">Create a Quiz</h2>

            <input type="hidden" asp-for="Quiz.QuizId" />
            <input type="hidden" asp-for="Question.QuestionId" />

            <label class="form-label">Use Existing Category?</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="CategoryChoice" value="yes" id="existing-category" checked>
                <label class="form-check-label" for="existing-category">Yes</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="CategoryChoice" value="no" id="new-category">
                <label class="form-check-label" for="new-category">No</label>
            </div>

            <div id="existing-category-container" class="mb-3">
                <label asp-for="Quiz.QuizCategory" class="form-label">Category:</label>
                <select asp-for="Quiz.QuizCategory" class="form-select" id="QuizCategory" name="Quiz.QuizCategory" required>
                    <option value="">-- Select a Category --</option>
                    @foreach (var item in (SelectList)ViewData["Tissue_Info"]!)
                    {
                        <option value="@item.Text">@item.Text</option>
                    }
                </select>
                <span asp-validation-for="Quiz.QuizCategory" class="text-danger"></span>
            </div>

            <div id="new-category-container" class="mb-3" style="display:none;">
                <label asp-for="Quiz.QuizCategory" class="form-label">New Category:</label>
                <input asp-for="Quiz.QuizCategory" type="text" class="form-control" id="new-QuizCategory" name="Quiz.QuizCategory">
                <span asp-validation-for="Quiz.QuizCategory" class="text-danger"></span>
            </div>

            <label asp-for="Question.QuestionText" class="form-label">Question:</label>
            <input asp-for="Question.QuestionText" type="text" class="form-control" id="QuestionText" name="Question.QuestionText" required>

            <label asp-for="Question.QuestionType" class="form-label">Question Type:</label>
            <select asp-for="Question.QuestionType" class="form-select" id="QuestionType" name="Question.QuestionType" required>
                <option value="">Select a question type</option>
                <option value="Multiple Choice (Radio)">Multiple Choice (Radio)</option>
                <option value="Multiple Choice (Checkbox)">Multiple Choice (Checkbox)</option>
                <option value="Multiple Choice (Dropdown)">Multiple Choice (Dropdown)</option>
            </select>

            <label for="Answers" class="form-label">Number of Answers:</label>
            <select id="Answers" class="form-select" name="Answers" onchange="generateAnswerFields(parseInt(this.value))">
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
            </select>

            <div id="answers-container" class="mt-3"></div>

            <div id="total-marks-container" class="mb-3">
                <strong>Total Marks: </strong><span id="question-marks">0</span>
                <input type="hidden" asp-for="Question.QuestionMark" id="QuestionMark" name="Question.QuestionMark" value="0" />
            </div>

            <label asp-for="Photos.PhotoFile" class="form-label">Upload Picture:</label>
            <input asp-for="Photos.PhotoFile" type="file" class="form-control mb-3" id="PhotoFile" name="Photo.PhotoFile">
            <img id="image-preview" alt="Image Preview" class="img-thumbnail d-none" style="max-width:200px; max-height:200px;">

            <button type="submit" class="btn btn-primary w-100">Submit</button>
        </form>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function generateAnswerFields(count) {
            const answersContainer = document.getElementById("answers-container");
            answersContainer.innerHTML = "";
            for (let i = 0; i < count; i++) {
                const answerDiv = document.createElement("div");
                answerDiv.classList.add("mb-2");
                answerDiv.innerHTML = `
                    <label class="form-label">Answer ${i + 1}:</label>
                    <input type="text" class="form-control" name="Answers[${i}].Text" required>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" style="border: 2px solid black;" name="Answers[${i}].IsCorrect" onchange="toggleMarksField(this, ${i})">
                        <label class="form-check-label">Correct</label>
                    </div>
                    <div id="marks-container-${i}" style="display: none;">
                        <label class="form-label">Marks:</label>
                        <input type="number" class="form-control" name="Answers[${i}].Marks" min="0" step="0.5" value="0">
                    </div>
                `;
                answersContainer.appendChild(answerDiv);
            }
        }

        function toggleMarksField(checkbox, index) {
            const marksContainer = document.getElementById(`marks-container-${index}`);
            marksContainer.style.display = checkbox.checked ? "block" : "none";
        }

        document.addEventListener('DOMContentLoaded', function () {
            generateAnswerFields(parseInt(document.getElementById("Answers").value));
        });
    </script>
</body>
