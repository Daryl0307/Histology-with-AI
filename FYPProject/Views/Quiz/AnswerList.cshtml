@using FYPProject.Models
@model List<Answer>

@section MoreScripts {
    <link href="~/lib/datatables/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#jsTable').DataTable({
                paging: true,
                ordering: true,
                info: true,
                lengthChange: true,
                pageLength: 5,
                stateSave: true,
                lengthMenu: [[5, 7, -1], [5, 7, "All"]],
                searching: false
            });
        });
    </script>
}

@if (TempData["Message"] != null)
{
    <div class="tempdata-popup @TempData["MsgType"]">
        <div class="alert alert-@TempData["MsgType"]">
            @TempData["Message"]
            <button type="button" class="btn-close" onclick="closePopup();">&times;</button>
        </div>
    </div>

    <script>
        function closePopup() {
            $('.tempdata-popup').removeClass('active');
        }

        $(document).ready(function () {
            $('.tempdata-popup').addClass('active');
            setTimeout(function () {
                closePopup();
            }, 3000);
        });
    </script>
}

<!DOCTYPE html>
<html>
<head>
    <title>Interactive Answers</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="icon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="~/css/HistoQuiz.css" rel="stylesheet" />
</head>
<body style="background-color: #80cbc4;">
    <div class="container mt-5">
        <div class="card p-4 bg-white shadow-lg rounded">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
                <h1 class="text-dark" style="font-weight: 400;">Answers</h1>

                @if (Model != null && Model.Count() < 4)
                {
                    if (ViewBag.QuestionType == "Multiple Choice (Radio)" && ViewBag.AnswerCount == 2)
                    {
                        // Skip this block as it is handled elsewhere
                    }
                    else
                    {
                        <a class="btn btn-primary" asp-controller="Quiz" asp-action="AddAnswer" asp-route-id="@ViewBag.QuestionId" role="button">
                            <i class="fas fa-plus"></i> Add Answer
                        </a>
                    }
                }
            </div>

            <div class="card mt-4">
                <div class="table-responsive">
                    <table id="jsTable" class="table table-bordered table-striped">
                        <thead class="table-header">
                            <tr>
                                <th scope="col">Question ID</th>
                                <th scope="col">Answer ID</th>
                                <th scope="col">Answer Text</th>
                                <th scope="col">Correct Answer</th>
                                <th scope="col">Marks</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var answer in Model)
                                {
                                    <tr>
                                        <td>@answer.QuestionId</td>
                                        <td>@answer.AnswerId</td>
                                        <td>@answer.AnswerText</td>
                                        <td>
                                            @if (answer.Is_Correct)
                                            {
                                                <span class="text-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">No</span>
                                            }
                                        </td>
                                        <td>@answer.Marks</td>
                                        <td>
                                            <a asp-controller="Quiz" asp-action="UpdateAnswer" asp-route-id="@answer.AnswerId" title="Edit">
                                                <i class="fas fa-pencil-alt text-primary"></i>
                                            </a>
                                            <span>|</span>
                                            <a asp-controller="Quiz" asp-action="DeleteAnswer" asp-route-id="@answer.AnswerId"
                                               onclick="return confirm('Are you sure you want to delete this answer?');" title="Delete">
                                                <i class="fas fa-trash text-danger"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center">No answers available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/jquery.min.js"></script>
</body>
</html>
