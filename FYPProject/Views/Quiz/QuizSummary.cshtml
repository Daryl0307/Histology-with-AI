@using FYPProject.Model;
@model IEnumerable<QuizSummaryResponse>



@if (TempData["Message"] != null)
{
    <div class="tempdata-popup @TempData["MsgType"]">
        <div class="alert alert-@TempData["MsgType"]">
            @TempData["Message"]
            <button type="button" class="btn-close" onclick="closePopup();">&times;</button>
        </div>
    </div>
}


<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="icon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href='https://fonts.googleapis.com/css2?family=Raleway:wght@400;600&display=swap' rel='stylesheet'>
    <link href="~/css/HistoQuiz.css" rel="stylesheet" />
</head>
<body>
    @await Html.PartialAsync("navbar")
    <div class="container mt-5">
        <div class="big-card">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h1 class="text-dark">Quiz Summary</h1>
                </div>
                <div class="col-md-6 d-flex justify-content-end align-items-center">
                    <div class="d-flex justify-content-between w-100">
                        <!-- Total Score -->
                        <p class="card-text">Total Score: <span class="stats-card">@ViewBag.TotalScore</span></p>
                        <!-- Back to quiz button -->
                        <a class="btn btn-primary" asp-controller="Quiz" asp-action="Quit">Back to HistoQuiz</a>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="table-header">
                            <tr>
                                <th scope="col">Question</th>
                                <th scope="col">Answer</th>
                                <th scope="col">Correct</th>
                                <th scope="col">Score</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var response in Model)
                            {
                                <tr>
                                    <td>@response.QuestionText</td>
                                    <td>@response.AnswerText</td>
                                    <td>
                                        @if (response.IsCorrect)
                                        {
                                            <span class="text-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">No</span>
                                        }
                                    </td>
                                    <td>@response.Score</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>


    </div>
    </div>

    <script>
        // Close popup when user clicks the close button
        function closePopup() {
            document.querySelector('.tempdata-popup').style.display = 'none';
        }
    </script>
</body>