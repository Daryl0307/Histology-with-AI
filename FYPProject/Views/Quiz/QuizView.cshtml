@using FYPProject.Models
@model List<HistoQuiz>

<!DOCTYPE html>
<html>
<head>
    <title>Interactive Quizzes</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="icon.png">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href='https://fonts.googleapis.com/css2?family=Raleway:wght@400;600&display=swap' rel='stylesheet'>
    <link href="~/css/HistoQuiz.css" rel="stylesheet" />
</head>
<body style="background-color: #80cbc4;">
    <div class="container mt-5">
        <div class="card p-4 bg-white shadow-lg rounded">

            <div class="container mt-5">
                <div class="big-card">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h1 class="text-dark">Quizzes</h1>
                        </div>
                        <div class="col-md-6 d-flex justify-content-end align-items-center">
                            <a class="btn btn-primary" asp-controller="Quiz" asp-action="AddQuiz" role="button"><i class="fas fa-plus"></i> Add Quiz</a>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-xl-4 col-lg-6 mb-3">
                            <div class="card stats-card bg-success text-white">
                                <div class="card-body d-flex align-items-center">
                                    <i class="fas fa-trophy stats-icon me-3"></i>
                                    <div class="text-left">
                                        <h3 id="noofquiz">@(Model != null ? Model.GroupBy(m => m.QuizCategory!).Count() : 0)</h3>
                                        <p>Quizzes Available</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-4 col-lg-6 mb-3">
                            <div class="card stats-card bg-primary text-white">
                                <div class="card-body d-flex align-items-center">
                                    <i class="fas fa-chart-line stats-icon me-3"></i>
                                    <div class="text-left">
                                        <h3 id="passRate">@ViewBag.passpercent%</h3>
                                        <p>Passing Rate</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-4 col-lg-6 mb-3">
                            <div class="card stats-card bg-info text-white">
                                <div class="card-body d-flex align-items-center">
                                    <i class="fas fa-pen stats-icon me-3"></i>
                                    <div class="text-left">
                                        <h3 id="attempts">@ViewBag.TotalAttempts</h3>
                                        <p>Total Attempts</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h1 class="text-dark">Manage Quizzes</h1>
                        </div>
                        <div class="col-md-6 d-flex justify-content-end align-items-center">
                            <select class="form-select w-auto" id="idQuizCategoryChooser">
                                <option value="">Select Quiz Category</option>
                                @if ((SelectList)ViewData["Tissue_Info"] == null)
                                {
                                    <option value=""></option>
                                }
                                else
                                {
                                    @foreach (var item in (SelectList)ViewData["Tissue_Info"]!)
                                    {
                                        <option value="@item.Text">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var HistoQuiz in Model)
                            {
                                <div class="col-md-4 mb-4">
                                    <div class="card" data-category="@HistoQuiz.QuizCategory">
                                        <div class="card-body">
                                            <h5 class="card-title">@HistoQuiz.QuizCategory</h5>
                                            <p class="card-text">Marks: @HistoQuiz.TotalQuestionMarks</p>
                                            <a asp-controller="Quiz" asp-action="Management" asp-route-quizCategory="@HistoQuiz.QuizCategory" class="btn btn-primary">Manage Quiz</a>
                                            <a asp-controller="Quiz" asp-action="QuizStatistics" asp-route-quizCategory="@HistoQuiz.QuizCategory" class="btn btn-primary">Quiz Statistics</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center">No quizzes available.</td></tr>
                        }
                    </div>
                </div>
            </div>
            
            <script>
                $(document).ready(function () {
                    $('#idQuizCategoryChooser').on('change', function () {
                        var selectedCategory = $(this).val().toLowerCase().trim(); // Get selected category

                        $('.col-md-4').each(function () {
                            var cardCategory = $(this).find('.card').attr('data-category');
                            cardCategory = cardCategory ? cardCategory.toLowerCase().trim() : '';

                            if (!selectedCategory || cardCategory === selectedCategory) {
                                $(this).show();  // Show matching quiz cards
                            } else {
                                $(this).hide();  // Hide non-matching quiz cards
                            }
                        });
                    });
                });
            </script>

</body>
</html>
