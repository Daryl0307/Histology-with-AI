@model FYPProject.Models.QuizViewModelForManagement

<head>
    <meta charset="UTF-8">
    <link href="~/css/AddQuiz.css" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Quiz</title>
    <script>
                /* Applying the requested CSS styles */
                body {
            margin: 0;
            font - family: Arial, sans - serif;
            background - color: #80cbc4;
            color: #333;
        }

                form {
            max - width: 900px;
            margin: 0 auto;
            background - color: #ffffff;
            padding: 20px;
            border - radius: 10px;
            box - shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

                label {
            display: inline - block;
            margin - bottom: 10px;
            font - weight: bold;
        }

        input[type = "text"], select, input[type = "file"] {
            width: 100 %;
            padding: 8px;
            margin - bottom: 15px;
            border: 1px solid #ddd;
            border - radius: 5px;
        }

        input[type = "radio"] {
            margin - right: 5px;
        }

                .file - input - container {
            display: flex;
            align - items: center;
        }

                    .file - input - container input[type = "file"] {
            width: auto;
            margin - right: 10px;
        }

                    .file - input - container button {
            background - color: #e74c3c;
            color: white;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
            border - radius: 5px;
        }

                        .file - input - container button:hover {
            background - color: #c0392b;
        }

        #image - preview {
            max - width: 200px;
            max - height: 200px;
            margin: 10px 0;
            display: none;
        }

                .answers - container {
            margin - bottom: 20px;
        }

                .Answer {
            margin - bottom: 15px;
        }

                    .Answer input[type = "text"], .marks - input {
            width: 70 %;
        }

                .marks - input {
            display: none;
            width: 20 %;
            margin - left: 10px;
        }

                .marks - label {
            display: inline;
        }

        #total - marks - container {
            margin - top: 20px;
            font - weight: bold;
        }

        button[type = "submit"] {
            background - color: #3498db;
            color: white;
            padding: 10px 20px;
            border: none;
            border - radius: 5px;
            cursor: pointer;
            font - size: 16px;
            width: 100 %;
        }

        button[type = "submit"]:hover {
            background - color: #2980b9;
        }

                .text - danger {
            color: red;
        }
    </script>
</head>
<body>
    <form id="quiz-form" asp-controller="Quiz" asp-action="UpdateQuiz" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Question_ID" />

        <!-- Quiz Category Dropdown -->
        <label asp-for="Quiz_Category">Category:</label>
        <select asp-for="Quiz_Category" id="Quiz_Category" name="Quiz_Category" required>
            @if ((SelectList)ViewData["Tissue_Info"] == null)
            {
                <option value="" disabled>No categories available</option>
            }
            else
            {
                @foreach (var item in (SelectList)ViewData["Tissue_Info"]!)
                {
                    <option value="@item.Text">@item.Text</option>
                }
            }
        </select>

        <!-- Question Text Input -->
        <label asp-for="QuestionText">Question:</label>
        <input asp-for="QuestionText" type="text" id="QuestionText" name="QuestionText" required value="@Model.QuestionText" class="input-field" />QQ

        <!-- Question Type Dropdown -->
        <label asp-for="QuestionType">Question Type:</label>
        <select asp-for="QuestionType" id="QuestionType" name="QuestionType" required>
            <option value="">Select a question type</option>
            <option value="Multiple Choice (Radio)">Multiple Choice (Radio)</option>
            <option value="Multiple Choice (Checkbox)">Multiple Choice (Checkbox)</option>
            <option value="Multiple Choice (Dropdown)">Multiple Choice (Dropdown)</option>
        </select>

        <!-- Picture URL (Hidden) -->
        <label asp-for="Photo_URL">Picture:</label>
        <input asp-for="Photo_URL" type="text" value="@Model.Photo_URL" hidden />

        <!-- Image Preview -->
        <img id="image-preview"
             src="@((Model.Photo_URL == "No Picture Inserted") ? "" : Url.Content("~/images/" + Model.Quiz_Category + "/" + Model.Photo_URL))"
             alt="Image Preview"
             style="display:@((Model.Photo_URL == "No Picture Inserted") ? "none" : "block"); height:350px; max-width:100%;">
        <p id="no-picture-message" style="display:@((Model.Photo_URL == "No Picture Inserted") ? "block" : "none");">No Picture Inserted</p>

        <!-- File Input for Photo -->
        <input asp-for="Photos" type="file" id="Photos" name="Photo" class="file-input">

        <!-- Total Marks Section -->
        <div id="total-marks-container">
            <strong>Total Marks: </strong><span id="question-marks">@Model.QuestionMarks</span>
            <input type="hidden" asp-for="QuestionMarks" id="QuestionMark" name="Question.QuestionMark" value="@Model.QuestionMarks" />
        </div>

        <!-- Submit Button -->
        <button type="submit" class="submit-btn">Update</button>
    </form>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const fileInput = document.getElementById('Photo');
            const preview = document.getElementById('image-preview');
            const noPictureMessage = document.getElementById('no-picture-message');

            fileInput.addEventListener('change', function () {
                const file = this.files[0];
                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block'; // Show the image
                    noPictureMessage.style.display = 'none'; // Hide the message
                };

                if (file) {
                    reader.readAsDataURL(file); // Read the file to update the preview
                }
            });
        });
    </script>
</body>
