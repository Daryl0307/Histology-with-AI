@using FYPProject.Models;
@model List<QuizViewModel>
@{
    Layout = "_Layout";  // Ensure the layout is referenced correctly
}
@section MoreScripts {
    <link href="~/lib/datatables/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#jsTable').DataTable({
                paging: true,
                ordering: true,
                info: true,
                lengthChange: true,
                pageLength: 5,
                stateSave: true,
                lengthMenu: [[5, 7, -1], [5, 7, "All"]],
                searching: false
            });
        });
    </script>
}
@if (TempData["Message"] != null)
{
    <div class="tempdata-popup @TempData["MsgType"]">
        <div class="alert alert-@TempData["MsgType"]">
            @TempData["Message"]
            <button type="button" class="btn-close" onclick="closePopup();">&times;</button>
        </div>
    </div>

    <script>
        function closePopup() {
            $('.tempdata-popup').removeClass('active');
        }
        $(document).ready(function () {
            $('.tempdata-popup').addClass('active');
            setTimeout(function () { closePopup(); }, 3000);
        });
    </script>
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quizzes Management</title>
    <link rel="icon" type="image/png" href="icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/HistoQuiz.css" rel="stylesheet" />
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #80cbc4;
            color: #333;
        }

        .big-card {
            margin: 20px auto;
            padding: 30px;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .stats-card {
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .table-header {
            background-color: #1ABC9C;
            color: #ffffff;
            text-align: center;
        }
    </style>
</head>
<body >
    <div class="container mt-5">
        <div class="card big-card">
            <div class="card-body">
                <div class="manage-section mb-3">
                    <h1 style="font-weight:400">Manage Quizzes</h1>
                    <select class="form-select w-auto" id="idQuizCategoryChooser">
                        <option value="">Select Quiz Category</option>
                        @if ((SelectList)ViewData["Tissue_Info"] != null)
                        {
                            @foreach (var item in (SelectList)ViewData["Tissue_Info"]!)
                            {
                                <option value="@item.Text">@item.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="table-responsive">
                    <table id="jsTable" class="table table-bordered">
                        <thead class="table-header">
                            <tr>
                                <th>Category</th>
                                <th>Question</th>
                                <th>Type</th>
                                <th>Marks</th>
                                <th>Answers</th>
                                <th>Picture</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var quizViewModel in Model)
                                {
                                    <tr data-category="@quizViewModel.Quiz.QuizCategory">
                                        <td>@quizViewModel.Quiz.QuizCategory</td>
                                        <td>@quizViewModel.Question.QuestionText</td>
                                        <td>@quizViewModel.Question.QuestionType</td>
                                        <td>@quizViewModel.Question.QuestionMark</td>
                                        <td>
                                            <a asp-controller="Quiz" asp-action="AnswerList" asp-route-id="@quizViewModel.Question.QuestionId">Answers</a>
                                        </td>
                                        <td>
                                            @if (quizViewModel.Photos.Photo_URL == "No Picture Inserted")
                                            {
                                                <p>@quizViewModel.Photos.Photo_URL</p>
                                            }
                                            else
                                            {
                                                <img src="@Url.Content("~/images/" + quizViewModel.Quiz.QuizCategory + "/" + quizViewModel.Photos.Photo_URL)"
                                                     width="150" height="90" class="rounded" />
                                            }
                                        </td>
                                        <td>
                                            <a asp-controller="Quiz" asp-action="UpdateQuiz" asp-route-id="@quizViewModel.Question.QuestionId">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>
                                            <span>|</span>
                                            <a asp-controller="Quiz" asp-action="DeleteQuiz" asp-route-id="@quizViewModel.Question.QuestionId" onclick="return confirm('Are you sure?');">
                                                <i class="fas fa-trash text-danger"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center">No quizzes available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
