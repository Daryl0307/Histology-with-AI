@using FYPProject.Model;
@model List<QuizViewModel>

@section MoreScripts {
    <link href="~/lib/datatables/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#jsTable').DataTable({
                paging: true,
                ordering: true,
                info: true,
                lengthChange: true,
                pageLength: 5,
                stateSave: true,
                lengthMenu: [[5, 7, -1], [5, 7, "All"]]
            });
        });
    </script>
}
@if (TempData["Message"] != null)
{
    <div class="tempdata-popup @TempData["MsgType"]">
        <div class="alert alert-@TempData["MsgType"]">
            @TempData["Message"]
            <button type="button" class="btn-close" onclick="closePopup();">&times;</button>
        </div>
    </div>

    <script>
        function closePopup() {
            $('.tempdata-popup').removeClass('active');
        }

        $(document).ready(function () {
            $('.tempdata-popup').addClass('active');
            // Auto-close popup after 3 setTimeout(function () {closePopup();}, 3000);
        });
    </script>
}



<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quizzes Management</title>
    <link rel="icon" type="image/png" href="icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/QuizManagement.css" rel="stylesheet" />
</head>
<body>
    @await Html.PartialAsync("navbar")
    <div class="container mt-5">
        <div class="card big-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
                    <h1 style="font-weight:400">Quizzes</h1>
                    <a class="btn btn-add-quiz" asp-controller="Quiz" asp-action="AddQuiz" role="button"><i class="fas fa-plus"></i> Add Quiz</a>
                </div>

                <div class="stats-group mb-4">
                    <div>
                        <h3 id="quizzesAvailable" style="color: #FF5662;"> @(Model != null ? Model.GroupBy(m => m.Quiz.QuizCategory!).Count() : 0)</h3>
                        <p>Quizzes Available</p>
                        <i class="fas fa-edit fa-2x" style="color: #FF5662;"></i>
                    </div>
                    <div>
                        <h3 id="quizzesCompleted" style="color: #00D207;">@ViewBag.TotalAttempts</h3>
                        <p>Quiz Attempts</p>
                        <i class="fas fa-check-circle fa-2x" style="color: #00D207;"></i>
                    </div>
                    <div>
                        <h3 id="passPercentage" class="text-primary">0%</h3>
                        <p>Passing Rate</p>
                        <i class="fas fa-book fa-2x text-primary"></i>
                    </div>
                </div>

                <div class="manage-section">
                    <h1 style="font-weight:400">Manage Quizzes</h1>
                    <select class="form-select w-auto" id="idQuizCategoryChooser">
                        <option value="">Select Quiz Category</option>
                        @if ((SelectList)ViewData["Tissue_Info"] == null)
                        {
                            <option value=""></option>
                        }
                        else
                        {
                            @foreach (var item in (SelectList)ViewData["Tissue_Info"]!)
                            {
                                <option value="@item.Text">@item.Text</option>
                            }
                        }

                    </select>


                </div>

                <div class="table-responsive">
                    <table id="jsTable" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th scope="col">Category</th>
                                <th scope="col">Question</th>
                                <th scope="col">Type</th>
                                <th scope="col">Marks</th>
                                <th scope="col">Answers</th>
                                <th scope="col">Picture</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var quizViewModel in Model)
                                {
                                    <tr data-category="@quizViewModel.Quiz.QuizCategory">
                                        <td>@quizViewModel.Quiz.QuizCategory</td>
                                        <td>@quizViewModel.Question.QuestionText</td>
                                        <td>@quizViewModel.Question.QuestionType</td>
                                        <td>@quizViewModel.Question.QuestionMark</td>
                                        <td>
                                            <a asp-controller="Quiz" asp-action="AnswerList" asp-route-id="@quizViewModel.Question.QuestionId">Answers</a>
                                        </td>
                                        <td>
                                            <a>
                                                @if (quizViewModel.Photo.PhotoUrl == "No Picture Inserted")
                                                {
                                                    <p>@quizViewModel.Photo.PhotoUrl</p>
                                                }
                                                else
                                                {
                                                    <img src="@Url.Content("~/images/" + quizViewModel.Quiz.QuizCategory + "/" + quizViewModel.Photo.PhotoUrl)"
                                                         width="150" height="90"
                                                         class="pull-left" style="padding-right: 5px;" />
                                                }
                                            </a>
                                        </td>
                                        <td>
                                            <a asp-controller="Quiz" asp-action="UpdateQuiz" asp-route-id="@quizViewModel.Question.QuestionId" title="Edit">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>
                                            <span>|</span>
                                            <a asp-controller="Quiz" asp-action="DeleteQuiz" asp-route-id="@quizViewModel.Question.QuestionId"
                                               title="Delete" onclick="return confirm('Are you sure you want to delete this quiz?');">
                                                <i class="fas fa-trash text-danger"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center">No quizzes available.</td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            $('#idQuizCategoryChooser').on('change', function () {
                var selectedCategory = $(this).val().toLowerCase(); // Normalize case for comparison

                $('#jsTable tbody tr').each(function () {
                    var rowCategory = $(this).data('category') ? $(this).data('category').toLowerCase() : ''; // Normalize row category

                    if (!selectedCategory || rowCategory === selectedCategory) {
                        $(this).show(); // Show matching rows
                    } else {
                        $(this).hide(); // Hide non-matching rows
                    }
                });
            });
        });

    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
