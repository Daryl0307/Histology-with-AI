<!DOCTYPE html>
<html>
<head>
    <title>Interactive Quizzes</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="icon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href='https://fonts.googleapis.com/css2?family=Raleway:wght@400;600&display=swap' rel='stylesheet'>
    <link href="~/css/QuizMain.css" rel="stylesheet" />
</head>
<body>
    @await Html.PartialAsync("navbar")
    <div class="container mt-5">
        <div class="row mb-4">
            <div class="col-md-6">
                <h1 class="text-dark">Interactive Quizzes</h1>
            </div>
            <div class="col-md-6 d-flex justify-content-end align-items-center">
                <select class="form-select" id="quizCategorySelect">
                    <option value="">Choose a Category</option>
                    <option value="1">Lung</option>
                    <option value="2">Kidney</option>
                </select>
            </div>
        </div>

        <div id="quizContainer" class="row overflow-auto flex-nowrap">
        </div>

        <h1 class="mt-5">Quiz Performance</h1>
        <div class="row mb-4">
            <div class="col-xl-4 col-lg-6 mb-3">
                <div class="card stats-card bg-success text-white">
                    <div class="card-body d-flex align-items-center">
                        <i class="fas fa-trophy stats-icon me-3"></i>
                        <div class="text-left">
                            <h3 id="quizAttempts">0</h3>
                            <p>Quiz Attempts</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-lg-6 mb-3">
                <div class="card stats-card bg-primary text-white">
                    <div class="card-body d-flex align-items-center">
                        <i class="fas fa-chart-line stats-icon me-3"></i>
                        <div class="text-left">
                            <h3 id="passRate">0%</h3>
                            <p>Passing Rate</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-lg-6 mb-3">
                <div class="card stats-card bg-info text-white">
                    <div class="card-body d-flex align-items-center">
                        <i class="fas fa-pen stats-icon me-3"></i>
                        <div class="text-left">
                            <h3 id="avgScore">0%</h3>
                            <p>Average Score</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="table-responsive">
                <table id="quizHistory" class="table table-bordered">
                    <thead class="table-header">
                        <tr>
                            <th>Date</th>
                            <th>Quiz Title</th>
                            <th>Score</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/jquery.min.js"></script>

</body>
</html>