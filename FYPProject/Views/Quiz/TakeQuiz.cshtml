@model FYPProject.Models.QuizViewModel

@{
    ViewData["Title"] = "Take Quiz";
}
<link rel="stylesheet" href="~/css/TakeQuiz.css" />
<style>
    /* General Styles */
body {
    font-family: 'Raleway', sans-serif;
    background: linear-gradient(to bottom right, #f7f7f7, #e8f6f3);
    color: #2C3E50;
    margin: 0;
    padding: 0;
}

/* Quiz Container */
.quiz-container {
    max-width: 800px;
    margin: 40px auto;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    padding: 30px;
    overflow: hidden;
}

/* Quiz Title */
h2 {
    text-align: center;
    color: #1ABC9C;
    font-size: 2em;
    font-weight: 700;
    letter-spacing: 1px;
}

/* Image Container */
.quiz-image {
    text-align: center;
    margin-bottom: 20px;
}

.quiz-image img {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    border: 2px solid #e8f6f3;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
}

.quiz-image p {
    font-size: 0.95em;
    color: #7f8c8d;
}

/* Question Section */
.quiz-question {
    margin-bottom: 25px;
    padding: 20px;
    background: #eafaf1;
    border-radius: 10px;
    border-left: 6px solid #1ABC9C;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
}

.quiz-question h3 {
    color: #1ABC9C;
    font-size: 1.4em;
    font-weight: 600;
}

.quiz-question p {
    font-size: 1em;
    color: #34495e;
}

/* Answer Options */
.quiz-answers {
    margin-top: 20px;
}

.quiz-answers h3 {
    font-size: 1.2em;
    margin-bottom: 15px;
    color: #1ABC9C;
    font-weight: 600;
}

.form-check {
    margin-bottom: 15px;
    display: flex;
    align-items: center;
}

.form-check-input {
    margin-right: 12px;
    transform: scale(1.2);
    cursor: pointer;
}

.form-check-label {
    font-size: 1em;
    color: #2C3E50;
}

/* Dropdown Styling */
.form-control {
    padding: 12px;
    font-size: 1em;
    border-radius: 8px;
    border: 1px solid #ddd;
    width: 100%;
    margin-top: 10px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}

/* Submit Button */
button[type="submit"] {
    background-color: #1ABC9C;
    color: #ffffff;
    border: none;
    padding: 12px 25px;
    font-size: 1.1em;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
}

button[type="submit"]:hover {
    background-color: #16A085;
    transform: translateY(-3px);
}

/* Responsive Design */
@@media (max-width: 768px) {
    .quiz-container {
        padding: 20px;
    }

    h2 {
        font-size: 1.6em;
    }
}

</style>

<h2>Quiz: @Model.Quiz.QuizCategory</h2>
@if (Model != null && Model.Question != null)
{
    <div class="quiz-container">
        <!-- Display question image or a placeholder -->
        <div class="quiz-image">
            @if (Model.Photo_URL == "No Picture Inserted")
            {
                <p>No image available for this question.</p>
            }
            else
            {
                <img src="@Url.Content("~/images/" + Model.Quiz.QuizCategory + "/" + Model.Photo_URL)"
                     width="150" height="150" alt="Quiz image"
                     style="padding-right: 5px;" />
            }
        </div>

        <!-- Display question text -->
        <div class="quiz-question">
            <h3>Question:</h3>
            <p>@Model.Question.QuestionText</p>
        </div>

        <!-- Display answers according to question type -->
        <div class="quiz-answers">
            <h3>Choose your answers:</h3>

            <form method="post" asp-controller="Quiz" asp-action="SubmitAnswer" id="quizForm">
                @switch (Model.Question.QuestionType)
                {
                    case "Multiple Choice (Checkbox)":
                        @foreach (var answer in Model.Answer)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedAnswerIds" id="answer-@answer.AnswerId" value="@answer.AnswerId" />
                                <label class="form-check-label" for="answer-@answer.AnswerId">
                                    @answer.AnswerText
                                </label>
                                <input type="hidden" name="Marks" value="@answer.Marks" />
                            </div>
                        }
                        break;
                    case "Multiple Choice (Radio)":
                        @foreach (var answer in Model.Answer)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="selectedAnswerIds" id="answer-@answer.AnswerId" value="@answer.AnswerId" />
                                <label class="form-check-label" for="answer-@answer.AnswerId">
                                    @answer.AnswerText
                                </label>
                                <input type="hidden" name="Marks" value="@answer.Marks" />

                            </div>
                        }
                        break;
                    case "Multiple Choice (Dropdown)":
                        <div class="form-group">
                            <label for="answerSelect">Select your answer:</label>
                            <select class="form-control" name="selectedAnswerIds" id="answerSelect">
                                <option value="">-- Please choose an answer --</option>
                                @foreach (var answer in Model.Answer)
                                {
                                    <option value="@answer.AnswerId">@answer.AnswerText</option>

                                }
                            </select>

                        </div>
                        break;
                    default:
                        <p>Invalid question type.</p>
                        break;
                }

                <!-- Hidden fields to pass additional data -->
                <input type="hidden" name="QuizCategory" value="@Model.Quiz.QuizCategory" />
                <input type="hidden" name="QuestionId" value="@Model.Question.QuestionId" />
                <input type="hidden" name="QuizId" value="@Model.Question.QuizId" />


                <button type="submit" class="btn btn-primary mt-3">Submit</button>
            </form>
        </div>
    </div>

    <!-- Client-side validation for the form -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById('quizForm');

            form.addEventListener('submit', function (e) {
                const questionType = '@Model.Question.QuestionType';

                // Validation for Checkbox (Multiple Choice)
                if (questionType === "Multiple Choice (Checkbox)") {
                    // Get all selected checkboxes
                    const selectedCheckboxes = document.querySelectorAll('input[name="selectedAnswerIds"]:checked');

                    // Check if none are selected
                    if (selectedCheckboxes.length === 0) {
                        e.preventDefault();
                        alert('Please select at least one answer before submitting.');
                        return;
                    }
                }

                // Validation for Radio Button (Multiple Choice)
                if (questionType === "Multiple Choice (Radio)") {
                    const selectedRadio = document.querySelector('input[name="selectedAnswerIds"]:checked');
                    if (!selectedRadio) {
                        e.preventDefault();
                        alert('Please select an answer before submitting.');
                        return;
                    }
                }

                // Validation for Dropdown (Multiple Choice)
                if (questionType === "Multiple Choice (Dropdown)") {
                    const selectedDropdown = document.getElementById('answerSelect');
                    if (selectedDropdown.value === "") {
                        e.preventDefault();
                        alert('Please select an answer from the dropdown.');
                        return;
                    }
                }
            });

            // Prevent back navigation
            history.pushState(null, null, location.href);
            window.onpopstate = function () {
                history.pushState(null, null, location.href);
                alert("Back navigation is disabled on this page.");
            };
        });
    </script>



}
else
{
    <p>No quiz data available for this category.</p>
}
