@using FYPProject.Models;
@model List<TissueInfo>
@section MoreScripts {
    

    <script>
        $(document).ready(function () {
            
        });

    </script>
}

@{
    ViewData["Title"] = "Manage Lessons";
}
<head>
    <title>Interactive Quizzes</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="icon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <link href="~/lib/datatables/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href='https://fonts.googleapis.com/css2?family=Raleway:wght@400;600&display=swap' rel='stylesheet'>
    <link href="~/css/HistoQuiz.css" rel="stylesheet" />
    
</head>
<body style ="background-color: #80cbc4;">
    <div class="container mt-5">
        <div class="card p-4 bg-white shadow-lg rounded">
    <div class="container mt-5">
        <div class="big-card">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h1 class ="text-dark">Lessons</h1>
                </div>
                <div class="col-md-6 d-flex justify-content-end align-items-center">
                            <a asp-controller="Tissue" asp-action="AddTissue" class="btn btn-primary">+ Add Lesson</a>
                </div>
                </div>
                <div class="card big-card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span>Lessons Available: @ViewBag.noofLesson</span>
                        <i class="fas fa-edit text-danger"></i>
                    </div>
                </div>

                
            <div class="row mb-4">
            <div class="col-md-6">
                <h1 class="text-dark">Manage Lessons</h1>
            </div>

            <div class="col-md-6 d-flex justify-content-end align-items-center">
                <select class="form-select w-auto" id="idQuizCategoryChooser">
                    <option value="">Select Lesson Category</option>
                    @if ((SelectList)ViewData["Tissue_Info"] == null)
                    {
                        <option value=""></option>
                    }
                    else
                    {
                        @foreach (var item in (SelectList)ViewData["Tissue_Info"]!)
                        {
                            <option value="@item.Text">@item.Text</option>
                        }
                    }

                </select>
            </div>
            </div>
           
            <div class="card mt-4">
                <div class="table-responsive">
                    <table id="jsTable" class="table table-bordered table-striped">
                        <thead class="table-header">
                            <tr>
                                <th scope="col">Lesson Name</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var tissueInfo in Model)
                                {
                                    <tr data-category="@tissueInfo.TissueName">
                                        <td>
                                            @tissueInfo.TissueName
                                        </td>
                                        <td>
                                            <a asp-controller="Tissue" asp-action="UpdateTissue" asp-route-id="@tissueInfo.TissueId" title="Edit">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>                                            
                                            <span>|</span>
                                            <a asp-controller="Tissue" asp-action="DeleteTissue" asp-route-id="@tissueInfo.TissueId"
                                               title="Delete" onclick="return confirm('Are you sure you want to delete this Tissue?');">
                                                <i class="fas fa-trash text-danger"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center">No Lesson.</td></tr>

                            }
                        </tbody>
                    </table>
                </div>
            </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="editLessonModal" tabindex="-1" aria-labelledby="editLessonLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editLessonLabel">Edit Lesson Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="editLessonForm">
                        <input type="hidden" id="lessonId" name="lessonId">

                        <div class="mb-3">
                            <label for="lessonTitle" class="form-label">Title</label>
                            <input type="text" class="form-control" id="lessonTitle" name="Title">
                        </div>

                        <div class="mb-3">
                            <label for="lessonCategory" class="form-label">Category</label>
                            <select class="form-select" id="lessonCategory" name="Category">
                                @if ((SelectList)ViewData["Tissue_Info"] != null)
                                {
                                    @foreach (var item in (SelectList)ViewData["Tissue_Info"]!)
                                    {
                                        <option value="@item.Text">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="lessonDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="lessonDescription" name="Description" rows="3"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="lessonImage" class="form-label">Current Image</label>
                            <div id="lessonImagePreview"></div>
                            <button type="button" class="btn btn-danger mt-2" id="removeImage">Remove Current Image</button>
                        </div>

                        <div class="mb-3">
                            <label for="newLessonImage" class="form-label">Upload New Image</label>
                            <input type="file" class="form-control" id="newLessonImage" name="newImage">
                        </div>

                        <button type="submit" class="btn btn-success">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    </div>
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable) {
                $('#jsTable').DataTable({
                    paging: true,
                    ordering: true,
                    info: true,
                    lengthChange: true,
                    pageLength: 5,
                    stateSave: true,
                    lengthMenu: [[5, 7, -1], [5, 7, "All"]],
                    searching: false
                });
            } else {
                console.error("DataTables library is not loaded.");
            }

            $('#idQuizCategoryChooser').on('change', function () {
                var selectedCategory = $(this).val().toLowerCase(); // Get selected category

                $('#jsTable tbody tr').each(function () {
                    var rowCategory = $(this).attr('data-category') ? $(this).attr('data-category').toLowerCase() : '';

                    if (!selectedCategory || rowCategory === selectedCategory) {
                        $(this).show();  // Show matching rows
                    } else {
                        $(this).hide();  // Hide non-matching rows
                    }
                });
            });
        });


    </script>
</body>