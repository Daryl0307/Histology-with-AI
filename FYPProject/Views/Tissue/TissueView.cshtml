@using FYPProject.Models;
@model List<TissueViewModel>
<link href="~/css/TissueView.css" rel="stylesheet" />
<style>
    /* Global Styles */
    body {
        background-color: #90B2B8;
        font-family: Arial, sans-serif;
    }

    /* Main Content Container */
    .main-content {
        margin: 20px auto;
        padding: 30px;
        background-color: #ffffff;
        border-radius: 10px;
    }

    /* Slider Wrapper */
    .slider-wrapper {
        width: 80%;
        margin: auto;
        position: relative;
    }

    /* Slider Container */
    .slider-container {
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        display: inline-block;
        text-align: center;
    }

    /* Slider Items */
    .slider-item {
        display: none;
    }

        .slider-item.active {
            display: block;
        }

        .slider-item img {
            width: 100%;
            height: auto;
            object-fit: contain;
            margin: auto;
            display: block;
        }

    /* Navigation Buttons */
    .prev-button {
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(0, 0, 0, 0.5);
        border: none;
        padding: 0 10px;
        color: white;
        cursor: pointer;
        font-size: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1;
    }

    .next-button {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(0, 0, 0, 0.5);
        border: none;
        padding: 0 10px;
        color: white;
        cursor: pointer;
        font-size: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1;
    }

        .prev-button:hover, .next-button:hover {
            background-color: rgba(0, 0, 0, 0.8);
        }

    /* Description Container */
    .description-container {
        margin-top: 20px;
        padding: 20px;
        background-color: #f9f9f9;
        border-radius: 10px;
        width: 80%;
        margin: auto;
        max-width: 100%;
    }

    /* Responsive Styles */
    @@media (max-width: 768px) {
        .slider-wrapper {
            width: 90%;
        }

        .description-container {
            width: 90%;
        }
    }

    @@media (max-width: 480px) {
        .slider-wrapper {
            width: 95%;
        }

        .description-container {
            width: 95%;
        }
    }

    body {
    }

</style>
<div class="main-content">
    <div class="slider-wrapper">
        <div class="slider-container">
            @foreach (var tissue in Model)
            {
                if (tissue.PhotoURL != "No Picture Inserted")
                {
                    <div class="slider-item @(Model.IndexOf(tissue) == 0 ? "active" : "")">
                        <a href="#" class="image-link">
                            <img src="@Url.Content("~/images/" + tissue.TissueName + "/" + tissue.PhotoURL)" alt="@tissue.TissueName" class="zoomable">
                        </a>
                    </div>
                }
                
            }
        </div>
        <button class="prev-button" id="prevSlide">&#10094;</button>
        <button class="next-button" id="nextSlide">&#10095;</button>
    </div>

    <div class="description-container">
        <p id="description">
            @if (Model.Any())
            {
                @Html.Raw(Model.First().TissueDescription)
            }
        </p>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        let currentSlide = 0;
        const slides = document.querySelectorAll('.slider-item');
        const prevButton = document.getElementById('prevSlide');
        const nextButton = document.getElementById('nextSlide');
        const descriptionElement = document.getElementById('description');

        function updateSlide() {
            slides.forEach(slide => slide.classList.remove('active'));
            slides[currentSlide].classList.add('active');
        }

        prevButton.addEventListener('click', () => {
            currentSlide = (currentSlide > 0) ? currentSlide - 1 : slides.length - 1;
            updateSlide();
        });

        nextButton.addEventListener('click', () => {
            currentSlide = (currentSlide < slides.length - 1) ? currentSlide + 1 : 0;
            updateSlide();
        });

        document.querySelectorAll('.zoomable').forEach(img => {
            img.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                img.classList.toggle('zoomed');
            });
        });
    });
</script>
