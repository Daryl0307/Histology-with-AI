@using FYPProject.Models;
@model TissueInfo

<head>
    <meta charset="UTF-8">
    <link href="~/css/AddQuiz.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Quiz</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #80cbc4;
            color: #333;
        }

        form {
            max-width: 900px;
            margin: 0 auto;
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        label {
            display: inline-block;
            margin-bottom: 10px;
            font-weight: bold;
        }

        input[type="text"], select, input[type="file"] {
            width: 100%;
            padding: 8px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        input[type="radio"] {
            margin-right: 5px;
        }

        .file-input-container {
            display: flex;
            align-items: center;
        }

            .file-input-container input[type="file"] {
                width: auto;
                margin-right: 10px;
            }

            .file-input-container button {
                background-color: #e74c3c;
                color: white;
                border: none;
                padding: 5px 10px;
                cursor: pointer;
                border-radius: 5px;
            }

                .file-input-container button:hover {
                    background-color: #c0392b;
                }

        .image-preview {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            margin-top: 15px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background: #fafafa;
        }

            .image-preview img {
                max-width: 100px;
                max-height: 100px;
                object-fit: cover;
                border-radius: 5px;
            }

        .answers-container {
            margin-bottom: 20px;
        }

        .Answer {
            margin-bottom: 15px;
        }

            .Answer input[type="text"], .marks-input {
                width: 70%;
            }

        .marks-input {
            display: none;
            width: 20%;
            margin-left: 10px;
        }

        .marks-label {
            display: inline;
        }

        #total-marks-container {
            margin-top: 20px;
            font-weight: bold;
        }

        button[type="submit"] {
            background-color: #3498db;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            width: 100%;
        }

            button[type="submit"]:hover {
                background-color: #2980b9;
            }

        .text-danger {
            color: red;
        }

        label {
            display: inline-block;
            margin-right: 10px; /* Spacing between radio buttons */
        }
        /* Styling for CKEditor */
        #editor {
            border: 1px solid #ddd;
            padding: 10px;
            min-height: 150px;
            border-radius: 5px;
        }
        /* Make textarea focusable */
        .ckeditor-textarea {
            width: 100%;
            height: auto;
        }
    </style>
</head>

<body>
    <form id="quiz-form" asp-action="AddTissue" asp-controller="Tissue" method="post" enctype="multipart/form-data">
        <!-- Radio buttons for selecting existing category or new category -->
        <label>Use Existing Category?</label>
        <label>
            <input type="radio" name="CategoryChoice" value="yes" id="existing-category" checked> Yes
        </label>
        <label>
            <input type="radio" name="CategoryChoice" value="no" id="new-category"> No
        </label>

        <!-- Dropdown for existing category -->
        <div id="existing-category-container">
            <select asp-for="TissueName" id="TissueName" name="TissueName" required>
                <option value="">-- Select a Category --</option>
                @foreach (var item in (SelectList)ViewData["Tissue_Info"]!)
                {
                    <option value="@item.Text">@item.Text</option>
                }
            </select>
            <span asp-validation-for="TissueName" class="text-danger"></span>
        </div>

        <!-- Text input for new category -->
        <div id="new-category-container" style="display:none;">
            <label asp-for="TissueName">New Category:</label>
            <input asp-for="TissueName" type="text" id="new-TissueName" name="TissueName" required>
            <span asp-validation-for="TissueName" class="text-danger"></span>
        </div>

        <label asp-for="TissueDescription">Tissue Description:</label>

        <!-- CKEditor: Using a div to initialize CKEditor -->
        <div id="editor" contenteditable="true" class="ckeditor-textarea" required></div>
        <input type="hidden" asp-for="TissueDescription" id="TissueDescription" name="TissueDescription">

        <!-- Image preview and file input -->
        <label asp-for="PhotoFiles">Pictures:</label>
        <div class="image-preview" id="image-preview" style="display:none;"></div>
        <div class="file-input-container">
            <input asp-for="PhotoFiles" type="file" id="PhotoFiles" name="PhotoFiles" multiple>
            <button type="button" id="remove-photo" style="display:none;">
                <i class="fas fa-trash"></i>
            </button>
        </div>
        <span asp-validation-for="PhotoFiles" class="text-danger"></span>

        <button type="submit">Submit</button>
    </form>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-summary-errors">
            @foreach (var state in ViewData.ModelState)
            {
                foreach (var error in state.Value.Errors)
                {
                    <p>@state.Key :: @error.ErrorMessage</p>
                }
            }
        </div>
    }

    <!-- CKEditor Script -->
    <script src="https://cdn.ckeditor.com/ckeditor5/36.0.1/classic/ckeditor.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const photoInput = document.getElementById('PhotoFiles');
            const imagePreview = document.getElementById('image-preview');
            const removePhotoButton = document.getElementById('remove-photo');
            const existingCategoryRadio = document.getElementById('existing-category');
            const newCategoryRadio = document.getElementById('new-category');
            const existingCategoryContainer = document.getElementById('existing-category-container');
            const newCategoryContainer = document.getElementById('new-category-container');
            const tissueDescription = document.getElementById('editor');
            const form = document.getElementById('quiz-form');
            const tissueNameInput = document.getElementById('TissueName');
            const newTissueNameInput = document.getElementById('new-TissueName');

            // CKEditor Initialization
            let tissueEditor;

            ClassicEditor.create(document.getElementById('editor'), {
                toolbar: [
                    'undo', 'redo', '|',
                    'heading', '|',
                    'bold', 'italic', 'link', 'blockQuote', '|',
                    'numberedList', 'bulletedList', '|',
                    'insertTable', 'tableColumn', 'tableRow', 'mergeTableCells', '|',
                    'fontFamily', 'fontSize', 'alignment', '|', // Ensure fontFamily is here
                    'insertImage', 'mediaEmbed', '|',
                    'outdent', 'indent'
                ],
                fontFamily: {
                    options: [
                        'default',
                        'Arial, Helvetica, sans-serif',
                        'Courier New, Courier, monospace',
                        'Georgia, serif',
                        'Lucida Sans Unicode, Lucida Grande, sans-serif',
                        'Tahoma, Geneva, sans-serif',
                        'Times New Roman, Times, serif',
                        'Verdana, Geneva, sans-serif'
                    ],
                    supportAllValues: true
                },
                mediaEmbed: {
                    previewsInData: true,
                    providers: [
                        {
                            name: 'youtube',
                            url: /(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]+)/,
                            html: match => {
                                const videoId = match[1];
                                return `<iframe width="560" height="315"
                                            src="https://www.youtube.com/embed/${videoId}"
                                            frameborder="0" allowfullscreen></iframe>`;
                            }
                        },
                        {
                            name: 'default',
                            url: /^.+$/,
                            html: match => {
                                const url = match[0];
                                return `<iframe src="${url}" width="auto" height="315" frameborder="0" allowfullscreen></iframe>`;
                            }
                        }
                    ]
                }
            }).then(editor => {
                tissueEditor = editor;
            }).catch(error => {
                console.error('Error initializing CKEditor:', error);
            });


            // Add editor data to hidden field on form submit
            document.getElementById('quiz-form').addEventListener('submit', function () {
                document.getElementById('TissueDescription').value = tissueEditor.getData();
            });

            // Show the preview of the uploaded images
            photoInput.addEventListener('change', function () {
                const files = this.files;
                if (files.length > 0) {
                    imagePreview.style.display = 'block'; // Display the preview container
                    removePhotoButton.style.display = 'inline'; // Show the remove button
                    imagePreview.innerHTML = ''; // Clear any previous previews

                    Array.from(files).forEach(file => {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            imagePreview.appendChild(img);
                        };
                        reader.readAsDataURL(file);
                    });
                } else {
                    resetImagePreview();
                }
            });

            // Remove the uploaded images
            removePhotoButton.addEventListener('click', function () {
                resetImagePreview();
            });

            // Function to reset the image preview and file input
            function resetImagePreview() {
                photoInput.value = ''; // Clear the file input
                imagePreview.innerHTML = ''; // Clear all image previews
                imagePreview.style.display = 'none'; // Hide the preview container
                removePhotoButton.style.display = 'none'; // Hide the remove button
            }

            // Toggle visibility of the category selection fields based on radio button selection
            existingCategoryRadio.addEventListener('change', toggleCategoryFields);
            newCategoryRadio.addEventListener('change', toggleCategoryFields);

            function toggleCategoryFields() {
                if (existingCategoryRadio.checked) {
                    existingCategoryContainer.style.display = 'block';
                    newCategoryContainer.style.display = 'none';
                    tissueNameInput.removeAttribute('disabled');
                    newTissueNameInput.setAttribute('disabled', 'true');
                } else {
                    existingCategoryContainer.style.display = 'none';
                    newCategoryContainer.style.display = 'block';
                    tissueNameInput.setAttribute('disabled', 'true');
                    newTissueNameInput.removeAttribute('disabled');
                }
            }

            toggleCategoryFields(); // Initialize the fields based on the default selection

        });
    </script>
</body>
